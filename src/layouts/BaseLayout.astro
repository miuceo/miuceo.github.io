---
import '../styles/tokens.css';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonicalPath: string; // e.g. "/uz/" or "/uz/posts/my-slug/"
  hreflangPaths: Partial<Record<Lang, string>>; // lang -> full path, for pages that exist in that lang
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  canonicalPath,
  hreflangPaths,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site?.origin ?? 'https://muhammadjon.me';
const canonicalUrl = new URL(canonicalPath, site).toString();
const localeMap: Record<Lang, string> = { uz: 'uz_UZ', en: 'en_US', ru: 'ru_RU' };
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="alternate" type="application/rss+xml" title="The Muhammadjon Journal — RSS" href={`/${lang}/rss.xml`}>

{Object.entries(hreflangPaths).map(([hrefLang, path]) => (
  <link rel="alternate" hreflang={hrefLang} href={new URL(path, site).toString()} />
))}
{hreflangPaths.uz && <link rel="alternate" hreflang="x-default" href={new URL(hreflangPaths.uz, site).toString()} />}

<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:site_name" content="The Muhammadjon Journal">
<meta property="og:locale" content={localeMap[lang]}>
{ogImage && <meta property="og:image" content={ogImage}>}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{ogImage && <meta name="twitter:image" content={ogImage}>}

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<script is:inline>
  (function(){
    // A saved choice wins; otherwise follow the OS (day/night edition).
    var saved = null;
    try { saved = localStorage.getItem('miuceo_theme'); } catch (e) {}
    var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', saved || (dark ? 'dark' : 'light'));

    // Remember the language actually being read, so "/" honours it next visit
    // instead of re-deciding from Accept-Language. This is what makes the
    // manual override in ARCHITECTURE.md §6 actually stick — the language
    // switcher only navigates; nothing else persists the choice.
    var seg = (location.pathname.split('/')[1] || '').toLowerCase();
    if (seg === 'uz' || seg === 'en' || seg === 'ru') {
      localStorage.setItem('miuceo_lang', seg);
    }
  })();
</script>

<!-- Cloudflare Web Analytics (free, cookie-less). -->
<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "ae5a04a82730491caf10f8b24309e10f"}'></script>
</head>
<body>
<div class="wrap">
  <slot />
</div>
<script is:inline>
  (function(){
    function applyTheme(theme){
      document.documentElement.setAttribute('data-theme', theme);
    }
    function init(){
      var btn = document.getElementById('themeToggle');
      if(btn){
        btn.addEventListener('click', function(){
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          var next = current === 'light' ? 'dark' : 'light';
          try { localStorage.setItem('miuceo_theme', next); } catch (e) {}
          applyTheme(next);
        });
      }
      // Until the visitor picks one, keep tracking the OS setting live.
      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e){
          var saved = null;
          try { saved = localStorage.getItem('miuceo_theme'); } catch (err) {}
          if (!saved) applyTheme(e.matches ? 'dark' : 'light');
        });
      }
    }
    init();
  })();
</script>
</body>
</html>

<style is:global>
  .wrap{ max-width:1240px; margin:0 auto; padding:0 32px; position:relative; }

  /* Inner-page header: a newspaper section front — centred name, italic dek. */
  .page-header{ text-align:center; padding:44px 0 30px; border-bottom:1px solid var(--rule); }
  .page-header h1{ font-weight:900; font-size:56px; line-height:1.05; letter-spacing:-0.01em; margin:0 0 14px; }
  .page-header p{ font-family:var(--font-body); font-style:italic; font-size:19px; color:var(--ink-soft); max-width:640px; margin:0 auto; line-height:1.55; }

  .section-label{ font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink); margin:56px 0 20px; padding-top:8px; border-top:2px solid var(--rule); }

  .empty-state{ text-align:center; padding:60px 20px; color:var(--ink-soft); font-family:var(--font-body); font-style:italic; font-size:17px; }

  @media (max-width:640px){
    .wrap{ padding:0 16px; }
    .page-header{ padding:28px 0 22px; }
    .page-header h1{ font-size:36px; }
    .page-header p{ font-size:17px; }
    .section-label{ margin:40px 0 16px; }
  }
</style>
