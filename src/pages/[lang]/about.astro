---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);
const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/about/`])) as Record<Lang, string>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammadjon Ibrohimov',
  alternateName: 'miuceo',
  url: 'https://muhammadjon.me/',
  image: 'https://muhammadjon.me/images/avatar.png',
  sameAs: ['https://t.me/muhammadibrohimov_ceo', 'https://github.com/miuceo'],
  jobTitle: 'AI/ML Engineer',
};
---

<BaseLayout
  lang={lang}
  title={`${strings.about.title} — ${strings.masthead.name}`}
  description={strings.about.desc}
  canonicalPath={`/${lang}/about/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="about" langPaths={langPaths} />

  <section class="page-header">
    <h1>{strings.about.title}</h1>
    <p>{strings.about.desc}</p>
  </section>

  <section class="intro">
    <img class="avatar" src="/images/avatar.png" alt="Muhammadjon Ibrohimov" width="160" height="160" loading="lazy" />
    <div class="intro-text">
      <h2>{strings.about.introTitle}</h2>
      <p>{strings.about.intro}</p>
    </div>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.focusTitle}</h2>
    <div class="pill-row">
      {strings.about.focusItems.map((item: string, i: number) => {
        const accents = ['accent-cobalt', 'accent-coral', 'accent-green'];
        return <span class:list={['pill', accents[i % 3]]}>{item}</span>;
      })}
    </div>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.skillsTitle}</h2>
    <div class="pill-row">
      {strings.about.skills.map((item: string) => <span class="pill pill-skill">{item}</span>)}
    </div>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.timelineTitle}</h2>
    <ol class="timeline">
      {strings.about.timeline.map((entry: { date: string; title: string; desc: string }) => (
        <li class="timeline-item">
          <span class="timeline-date">{entry.date}</span>
          <h3 class="timeline-title">{entry.title}</h3>
          <p class="timeline-desc">{entry.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="block cv-block">
    <h2 class="block-title">{strings.about.cvTitle}</h2>
    <a href="/cv/muhammadjon-ibrohimov-cv-en.pdf" download class="btn btn-primary">{strings.about.cvButton}</a>
    <p class="cv-note">{strings.about.cvNote}</p>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.socialTitle}</h2>
    <div class="social-row">
      <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener" class="social-link">Telegram →</a>
      <a href="https://github.com/miuceo" target="_blank" rel="noopener" class="social-link">GitHub →</a>
      <a href="mailto:ibrokhimovmiu@gmail.com" class="social-link">Email →</a>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-5) 0;
  }
  .avatar {
    width: 200px;
    height: 240px;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-card);
    border: 1px solid var(--mid);
    background: var(--surface);
  }
  .intro-text h2 {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 var(--space-3);
    color: var(--text);
  }
  .intro-text p {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .block {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--mid);
  }
  .block-title {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-1-text);
    margin: 0 0 var(--space-3);
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pill {
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 11px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }
  .pill.accent-cobalt {
    background: var(--accent-1);
    color: var(--on-accent-1);
  }
  .pill.accent-coral {
    background: var(--accent-2);
    color: var(--on-accent-2);
  }
  .pill.accent-green {
    background: var(--accent-3);
    color: var(--on-accent-3);
  }
  .pill.pill-skill {
    background: var(--surface);
    color: var(--text);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 16px;
    border-left: 1px solid var(--mid);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .timeline-item {
    position: relative;
    padding-left: var(--space-3);
  }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: calc(-16px - 5px);
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-1);
  }
  .timeline-date {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-1-text);
    display: block;
    margin-bottom: 2px;
  }
  .timeline-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
    margin: 0 0 4px;
  }
  .timeline-desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
    max-width: 65ch;
  }

  .cv-block .btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cv-block .cv-note {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14px;
    color: var(--text);
    margin: var(--space-2) 0 0;
  }

  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .social-link {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-1-text);
    text-decoration: underline;
  }
  .social-link:hover {
    color: var(--accent-1);
  }

  @media (max-width: 640px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-4) 0;
    }
    .avatar {
      width: 140px;
      height: 168px;
    }
    .intro-text h2 {
      font-size: 26px;
    }
    .intro-text p {
      font-size: 17px;
    }
    .block {
      padding: var(--space-4) 0;
    }
  }
</style>
