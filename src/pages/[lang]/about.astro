---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);
const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/about/`])) as Record<Lang, string>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammadjon Ibrohimov',
  alternateName: 'miuceo',
  url: 'https://muhammadjon.me/',
  image: 'https://muhammadjon.me/images/avatar.png',
  sameAs: ['https://t.me/muhammadibrohimov_ceo', 'https://github.com/miuceo'],
  jobTitle: 'AI/ML Engineer',
};
---

<BaseLayout
  lang={lang}
  title={`${strings.about.title} — miuceo`}
  description={strings.about.desc}
  canonicalPath={`/${lang}/about/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="about" langPaths={langPaths} />

  <section class="page-header">
    <h1>{strings.about.title}</h1>
    <p>{strings.about.desc}</p>
  </section>

  <section class="intro">
    <img class="avatar" src="/images/avatar.png" alt="Muhammadjon Ibrohimov" width="160" height="160" loading="lazy" />
    <div class="intro-text">
      <h2>{strings.about.introTitle}</h2>
      <p>{strings.about.intro}</p>
    </div>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.focusTitle}</h2>
    <div class="pill-row">
      {strings.about.focusItems.map((item: string) => <span class="pill">{item}</span>)}
    </div>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.skillsTitle}</h2>
    <div class="pill-row">
      {strings.about.skills.map((item: string) => <span class="pill pill-skill">{item}</span>)}
    </div>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.timelineTitle}</h2>
    <ol class="timeline">
      {strings.about.timeline.map((entry: { date: string; title: string; desc: string }) => (
        <li class="timeline-item">
          <span class="timeline-date">{entry.date}</span>
          <h3 class="timeline-title">{entry.title}</h3>
          <p class="timeline-desc">{entry.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="block cv-block">
    <h2 class="block-title">{strings.about.cvTitle}</h2>
    <a href="/cv/muhammadjon-ibrohimov-cv-en.pdf" download class="btn">{strings.about.cvButton}</a>
    <p class="cv-note">{strings.about.cvNote}</p>
  </section>

  <section class="block">
    <h2 class="block-title">{strings.about.socialTitle}</h2>
    <div class="social-row">
      <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener" class="social-link">Telegram →</a>
      <a href="https://github.com/miuceo" target="_blank" rel="noopener" class="social-link">GitHub →</a>
      <a href="mailto:ibrokhimovmiu@gmail.com" class="social-link">Email →</a>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 36px;
    align-items: start;
    padding: 40px 0 36px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .avatar {
    width: 200px;
    height: 240px;
    object-fit: cover;
    display: block;
    border: 1px solid var(--rule);
  }
  .intro-text h2 { font-size: 34px; line-height: 1.1; margin: 0 0 16px; }
  .intro-text p { font-family: var(--font-body); font-size: 19px; line-height: 1.7; color: var(--ink); margin: 0; }
  .intro-text p::first-letter { font-family: var(--font-display); font-weight: 900; float: left; font-size: 4.1em; line-height: 0.82; margin: 0.06em 0.1em 0 0; }

  .block { max-width: 1000px; margin: 0 auto; padding: 12px 0 32px; border-top: 2px solid var(--rule); }
  .block-title {
    font-family: var(--font-sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); margin: 0 0 16px;
  }

  /* Focus areas and skills read as a printed list, not chips. */
  .pill-row { display: flex; flex-wrap: wrap; gap: 6px 0; font-family: var(--font-body); font-size: 18px; line-height: 1.5; }
  .pill { color: var(--ink); }
  .pill + .pill::before { content: '·'; margin: 0 12px; color: var(--accent); }
  .pill-skill { color: var(--ink-soft); font-size: 16px; }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline-item {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 28px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .timeline-item:first-child { border-top: none; padding-top: 0; }
  .timeline-date {
    grid-row: 1 / 3;
    font-family: var(--font-sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); padding-top: 5px;
  }
  .timeline-title { font-size: 21px; line-height: 1.2; margin: 0 0 6px; color: var(--ink); }
  .timeline-desc { font-family: var(--font-body); font-size: 16px; color: var(--ink-soft); line-height: 1.55; margin: 0; max-width: 640px; }

  .cv-block .cv-note { font-family: var(--font-body); font-style: italic; font-size: 15px; color: var(--ink-soft); margin: 12px 0 0; }

  .social-row { display: flex; flex-wrap: wrap; gap: 24px; }
  .social-link {
    font-family: var(--font-sans); font-size: 12px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink);
  }
  .social-link:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .intro { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 28px 0 24px; }
    .avatar { width: 140px; height: 168px; }
    .intro-text h2 { font-size: 28px; }
    .intro-text p { font-size: 17px; }
    .timeline-item { grid-template-columns: minmax(0, 1fr); }
    .timeline-date { grid-row: auto; padding: 0 0 4px; }
  }
</style>
