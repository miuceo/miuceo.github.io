---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);
const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/contact/`])) as Record<Lang, string>;
---

<BaseLayout
  lang={lang}
  title={`${strings.contact.title} — ${strings.masthead.name}`}
  description={strings.contact.desc}
  canonicalPath={`/${lang}/contact/`}
  hreflangPaths={langPaths}
>
  <Nav lang={lang} active="contact" langPaths={langPaths} />

  <section class="page-header">
    <h1>{strings.contact.title}</h1>
    <p>{strings.contact.desc}</p>
  </section>

  <div class="contact-grid">
    <div class="contact-card">
      <span class="label-pill pill-telegram">Telegram</span>
      <h2>@muhammadibrohimov_ceo</h2>
      <p>{strings.contact.telegramDesc}</p>
      <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener" class="contact-link">
        {strings.contact.telegramLink}
      </a>
    </div>

    <div class="contact-card">
      <span class="label-pill pill-github">GitHub</span>
      <h2>@miuceo</h2>
      <p>{strings.contact.githubDesc}</p>
      <a href="https://github.com/miuceo" target="_blank" rel="noopener" class="contact-link">
        {strings.contact.githubLink}
      </a>
    </div>

    <div class="contact-card">
      <span class="label-pill pill-email">Email</span>
      <h2>ibrokhimovmiu@gmail.com</h2>
      <p>{strings.contact.emailDesc}</p>
      <a href="mailto:ibrokhimovmiu@gmail.com" class="contact-link">
        {strings.contact.emailLink}
      </a>
    </div>
  </div>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-6);
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .contact-card {
    background: var(--bg);
    border: 1px solid var(--mid);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .contact-card:hover {
    border-color: var(--accent-1);
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent-1) 25%, transparent);
  }

  .label-pill {
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 11px;
    line-height: 1;
    display: inline-flex;
    width: fit-content;
    margin-bottom: var(--space-1);
  }
  .pill-telegram {
    background: var(--accent-1);
    color: var(--on-accent-1);
  }
  .pill-github {
    background: var(--accent-2);
    color: var(--on-accent-2);
  }
  .pill-email {
    background: var(--accent-3);
    color: var(--on-accent-3);
  }

  .contact-card h2 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    margin: 0;
    overflow-wrap: anywhere;
  }
  .contact-card p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text);
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }
  .contact-link {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-1-text);
    text-decoration: underline;
    width: fit-content;
    margin-top: auto;
    padding-top: var(--space-3);
  }
  .contact-link:hover {
    color: var(--accent-1);
  }
</style>
