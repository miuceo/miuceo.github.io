---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';
import { resolveLocalized, modelBadge } from '../../../lib/artifacts';

export async function getStaticPaths() {
  const allArtifacts = await getCollection('artifacts');
  return LANGS.flatMap((lang) =>
    allArtifacts.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'artifacts'>>>[number] };
const strings = t(lang);
const slug = entry.id;

const title = resolveLocalized(entry.data.title, lang);
const description = entry.data.description ? resolveLocalized(entry.data.description, lang) : strings.artifacts.disclaimer;
const badge = modelBadge(entry.data.model);

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/artifacts/${slug}/`])) as Record<Lang, string>;
const dateFmt = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' });

const site = Astro.site?.origin ?? 'https://muhammadjon.me';
const artifactFileUrl = new URL(entry.data.file, site).toString();
const artifactPageUrl = new URL(`/${lang}/artifacts/${slug}/`, site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  dateCreated: entry.data.date.toISOString(),
  creator: { '@type': 'Person', name: 'Muhammadjon Ibrohimov' },
  url: artifactPageUrl,
};
---

<BaseLayout
  lang={lang}
  title={`${title} — ${strings.masthead.name}`}
  description={description}
  canonicalPath={`/${lang}/artifacts/${slug}/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="artifacts" langPaths={langPaths} />

  <div class="artifact-page">
    <a href={`/${lang}/artifacts/`} class="back-link">← {strings.artifacts.backToList}</a>

    <header class="artifact-header">
      <span class="kind-pill">
        <span aria-hidden="true">{badge.emoji}</span> {strings.home.kickerArtifact} · {badge.label}
      </span>
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}
      <div class="meta-row">
        <time class="date" datetime={entry.data.date.toISOString()}>{dateFmt.format(entry.data.date)}</time>
        {entry.data.tags.length > 0 && <span class="tags">{entry.data.tags.join(' · ')}</span>}
      </div>

      {entry.data.requiresClaude && (
        <div class="notice">{strings.artifacts.requiresClaudeBadge}</div>
      )}

      {entry.data.prompt && (
        <details class="prompt-block">
          <summary>{strings.artifacts.promptLabel}</summary>
          <pre>{entry.data.prompt}</pre>
        </details>
      )}
    </header>

    <div class="toolbar">
      <button type="button" id="btnFullscreen" class="btn btn-ghost">{strings.artifacts.openFullscreen}</button>
      <a href={entry.data.file} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{strings.artifacts.openNewTab}</a>
      <button type="button" id="btnReload" class="btn btn-ghost">{strings.artifacts.reload}</button>
      <a href={entry.data.file} download={`${slug}.html`} class="btn btn-ghost">{strings.artifacts.download}</a>
      <button type="button" id="btnCopyLink" class="btn btn-ghost" data-url={artifactPageUrl}>{strings.artifacts.copyLink}</button>
      <button
        type="button"
        id="btnCopyEmbed"
        class="btn btn-ghost"
        data-embed={`<iframe src="${artifactFileUrl}" sandbox="allow-scripts allow-popups allow-forms" referrerpolicy="no-referrer" loading="lazy" style="width:100%;height:600px;border:1px solid rgba(128,128,128,0.4);border-radius:8px;"></iframe>`}
      >{strings.artifacts.copyEmbed}</button>
      <span id="copyStatus" class="copy-status" aria-live="polite"></span>
    </div>

    <div class="iframe-wrap" id="iframeWrap">
      <iframe
        id="artifactFrame"
        src={entry.data.file}
        title={title}
        sandbox="allow-scripts allow-popups allow-forms"
        referrerpolicy="no-referrer"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>

    <p class="footnote">{strings.artifacts.disclaimer} {strings.artifacts.noStorageNote}</p>
  </div>

  <Footer lang={lang} />
</BaseLayout>

<script define:vars={{ copiedText: strings.artifacts.linkCopied, embedCopiedText: strings.artifacts.embedCopied }}>
  const frame = document.getElementById('artifactFrame');
  const wrap = document.getElementById('iframeWrap');
  const status = document.getElementById('copyStatus');

  document.getElementById('btnFullscreen')?.addEventListener('click', () => {
    if (wrap?.requestFullscreen) wrap.requestFullscreen();
  });

  document.getElementById('btnReload')?.addEventListener('click', () => {
    if (frame instanceof HTMLIFrameElement) frame.src = frame.src;
  });

  function flashStatus(text) {
    if (!status) return;
    status.textContent = text;
    setTimeout(() => { status.textContent = ''; }, 2000);
  }

  document.getElementById('btnCopyLink')?.addEventListener('click', async (e) => {
    const url = e.currentTarget.dataset.url;
    try { await navigator.clipboard.writeText(url); flashStatus(copiedText); } catch {}
  });

  document.getElementById('btnCopyEmbed')?.addEventListener('click', async (e) => {
    const embed = e.currentTarget.dataset.embed;
    try { await navigator.clipboard.writeText(embed); flashStatus(embedCopiedText); } catch {}
  });
</script>

<style>
  .artifact-page {
    padding: var(--space-5) 0 var(--space-6);
  }
  .back-link {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-1-text);
    text-decoration: underline;
    display: inline-block;
    margin-bottom: var(--space-4);
  }
  .back-link:hover {
    color: var(--accent-1);
  }

  .artifact-header {
    margin-bottom: var(--space-4);
  }
  .kind-pill {
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 11px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--accent-3);
    color: var(--on-accent-3);
  }
  .artifact-header h1 {
    font-family: var(--font-heading);
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: var(--space-2) 0 var(--space-3);
    text-wrap: balance;
  }
  .description {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--text);
    line-height: 1.6;
    max-width: 65ch;
    margin: 0 0 var(--space-3);
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: var(--space-3) 0;
    margin-bottom: var(--space-3);
    border-top: 1px solid var(--mid);
    border-bottom: 1px solid var(--mid);
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }
  .date {
    font-weight: 600;
    color: var(--text);
  }
  .tags {
    color: var(--accent-1-text);
  }

  .notice {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    background: var(--surface);
    border-left: 4px solid var(--accent-2);
    padding: var(--space-2) var(--space-3);
    border-radius: 0 var(--radius-ui) var(--radius-ui) 0;
    margin-bottom: var(--space-3);
  }

  .prompt-block {
    margin-bottom: var(--space-3);
  }
  .prompt-block summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-1-text);
  }
  .prompt-block pre {
    white-space: pre-wrap;
    font-family: var(--mono);
    font-size: 13px;
    background: var(--surface);
    border: 1px solid var(--mid);
    border-radius: var(--radius-ui);
    padding: var(--space-3);
    margin-top: var(--space-2);
    color: var(--text);
  }

  .toolbar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--space-4);
  }
  .toolbar .btn {
    padding: 8px 14px;
    font-size: 13px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .copy-status {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-3);
  }

  .iframe-wrap {
    width: 100%;
    height: 70vh;
    min-height: 420px;
    border: 1px solid var(--mid);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
  }
  .iframe-wrap:fullscreen {
    height: 100dvh;
    border: none;
    border-radius: 0;
  }
  #artifactFrame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .footnote {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14px;
    color: var(--text);
    margin-top: var(--space-3);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .artifact-page {
      padding-top: var(--space-4);
    }
    .artifact-header h1 {
      font-size: 30px;
    }
    .description {
      font-size: 17px;
    }
    .iframe-wrap {
      height: 60vh;
    }
    .toolbar {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .toolbar .btn {
      padding: 10px 8px;
      text-align: center;
    }
    .copy-status {
      grid-column: 1 / -1;
    }
  }
</style>
