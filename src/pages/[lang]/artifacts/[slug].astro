---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';
import { resolveLocalized, modelBadge } from '../../../lib/artifacts';

export async function getStaticPaths() {
  const allArtifacts = await getCollection('artifacts');
  return LANGS.flatMap((lang) =>
    allArtifacts.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'artifacts'>>>[number] };
const strings = t(lang);
const slug = entry.id;

const title = resolveLocalized(entry.data.title, lang);
const description = entry.data.description ? resolveLocalized(entry.data.description, lang) : strings.artifacts.disclaimer;
const badge = modelBadge(entry.data.model);

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/artifacts/${slug}/`])) as Record<Lang, string>;
const dateFmt = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' });

const site = Astro.site?.origin ?? 'https://muhammadjon.me';
const artifactFileUrl = new URL(entry.data.file, site).toString();
const artifactPageUrl = new URL(`/${lang}/artifacts/${slug}/`, site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  dateCreated: entry.data.date.toISOString(),
  creator: { '@type': 'Person', name: 'Muhammadjon Ibrohimov' },
  url: artifactPageUrl,
};
---

<BaseLayout
  lang={lang}
  title={`${title} — miuceo`}
  description={description}
  canonicalPath={`/${lang}/artifacts/${slug}/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="artifacts" langPaths={langPaths} />

  <div class="artifact-page">
    <a href={`/${lang}/artifacts/`} class="back-link">← {strings.artifacts.backToList}</a>

    <header class="artifact-header">
      <div class="title-row">
        <h1>{title}</h1>
        <span class="model-badge">
          <span aria-hidden="true">{badge.emoji}</span> {badge.label}
        </span>
      </div>
      <div class="meta-row">
        <span class="date">{dateFmt.format(entry.data.date)}</span>
        {entry.data.tags.length > 0 && (
          <div class="tags">
            {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
      {description && <p class="description">{description}</p>}

      {entry.data.requiresClaude && (
        <div class="notice">{strings.artifacts.requiresClaudeBadge}</div>
      )}

      {entry.data.prompt && (
        <details class="prompt-block">
          <summary>{strings.artifacts.promptLabel}</summary>
          <pre>{entry.data.prompt}</pre>
        </details>
      )}
    </header>

    <div class="toolbar">
      <button type="button" id="btnFullscreen" class="btn ghost small">{strings.artifacts.openFullscreen}</button>
      <a href={entry.data.file} target="_blank" rel="noopener noreferrer" class="btn ghost small">{strings.artifacts.openNewTab}</a>
      <button type="button" id="btnReload" class="btn ghost small">{strings.artifacts.reload}</button>
      <a href={entry.data.file} download={`${slug}.html`} class="btn ghost small">{strings.artifacts.download}</a>
      <button type="button" id="btnCopyLink" class="btn ghost small" data-url={artifactPageUrl}>{strings.artifacts.copyLink}</button>
      <button
        type="button"
        id="btnCopyEmbed"
        class="btn ghost small"
        data-embed={`<iframe src="${artifactFileUrl}" sandbox="allow-scripts allow-popups allow-forms" referrerpolicy="no-referrer" loading="lazy" style="width:100%;height:600px;border:1px solid #ccc;border-radius:8px;"></iframe>`}
      >{strings.artifacts.copyEmbed}</button>
      <span id="copyStatus" class="copy-status" aria-live="polite"></span>
    </div>

    <div class="iframe-wrap" id="iframeWrap">
      <iframe
        id="artifactFrame"
        src={entry.data.file}
        title={title}
        sandbox="allow-scripts allow-popups allow-forms"
        referrerpolicy="no-referrer"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>

    <p class="footnote">{strings.artifacts.disclaimer} {strings.artifacts.noStorageNote}</p>
  </div>

  <Footer lang={lang} />
</BaseLayout>

<script define:vars={{ copiedText: strings.artifacts.linkCopied, embedCopiedText: strings.artifacts.embedCopied }}>
  const frame = document.getElementById('artifactFrame');
  const wrap = document.getElementById('iframeWrap');
  const status = document.getElementById('copyStatus');

  document.getElementById('btnFullscreen')?.addEventListener('click', () => {
    if (wrap?.requestFullscreen) wrap.requestFullscreen();
  });

  document.getElementById('btnReload')?.addEventListener('click', () => {
    if (frame instanceof HTMLIFrameElement) frame.src = frame.src;
  });

  function flashStatus(text) {
    if (!status) return;
    status.textContent = text;
    setTimeout(() => { status.textContent = ''; }, 2000);
  }

  document.getElementById('btnCopyLink')?.addEventListener('click', async (e) => {
    const url = e.currentTarget.dataset.url;
    try { await navigator.clipboard.writeText(url); flashStatus(copiedText); } catch {}
  });

  document.getElementById('btnCopyEmbed')?.addEventListener('click', async (e) => {
    const embed = e.currentTarget.dataset.embed;
    try { await navigator.clipboard.writeText(embed); flashStatus(embedCopiedText); } catch {}
  });
</script>

<style>
  .artifact-page { max-width: 1000px; margin: 0 auto; padding: 40px 0 100px; }
  .back-link { font-size: 13px; color: var(--ink-soft); display: inline-block; margin-bottom: 24px; }
  .back-link:hover { color: var(--accent); }

  .artifact-header { margin-bottom: 24px; }
  .title-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 10px; }
  .title-row h1 { font-size: 32px; font-weight: 700; margin: 0; }
  .model-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--accent); background: rgba(218,122,94,0.12); padding: 5px 12px; border-radius: 999px;
  }
  .meta-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
  .date { font-size: 13px; color: var(--ink-soft); }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag { font-size: 11px; color: var(--neon-cyan); background: var(--bg-3); border: 1px solid var(--line); padding: 4px 8px; border-radius: 4px; }
  .description { font-size: 15px; color: var(--ink-soft); line-height: 1.6; max-width: 700px; margin: 0 0 12px; }

  .notice { font-size: 13px; color: var(--accent); background: rgba(218,122,94,0.1); border: 1px solid var(--line); border-radius: 6px; padding: 10px 14px; margin-bottom: 12px; display: inline-block; }

  .prompt-block { margin-bottom: 12px; }
  .prompt-block summary { cursor: pointer; font-size: 13px; color: var(--ink-soft); font-weight: 600; }
  .prompt-block pre { white-space: pre-wrap; font-size: 13px; background: var(--bg-2); border: 1px solid var(--line); border-radius: 8px; padding: 14px; margin-top: 10px; color: var(--ink); }

  .toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
  .btn.small { padding: 7px 14px; font-size: 13px; }
  .copy-status { font-size: 12px; color: var(--accent); }

  .iframe-wrap {
    width: 100%;
    height: 70vh;
    min-height: 420px;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-2);
  }
  .iframe-wrap:fullscreen { height: 100dvh; border-radius: 0; }
  #artifactFrame { width: 100%; height: 100%; border: none; display: block; }

  .footnote { font-size: 12px; color: var(--ink-soft); margin-top: 16px; line-height: 1.6; }

  @media (max-width: 640px) {
    .artifact-page { padding: 24px 0 60px; }
    .title-row h1 { font-size: 24px; }
    .iframe-wrap { height: 60vh; }
    .toolbar { display: grid; grid-template-columns: 1fr 1fr; }
    .toolbar .btn.small { padding: 9px 6px; text-align: center; }
    .copy-status { grid-column: 1 / -1; }
  }
</style>
