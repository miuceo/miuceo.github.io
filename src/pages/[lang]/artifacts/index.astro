---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import ArtifactCard from '../../../components/ArtifactCard.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';
import { resolveLocalized } from '../../../lib/artifacts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);
const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/artifacts/`])) as Record<Lang, string>;

const artifacts = (await getCollection('artifacts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const models = [...new Set(artifacts.map((a) => a.data.model))].sort();
---

<BaseLayout
  lang={lang}
  title={`${strings.artifacts.title} — The Muhammadjon Journal`}
  description={strings.artifacts.desc}
  canonicalPath={`/${lang}/artifacts/`}
  hreflangPaths={langPaths}
>
  <Nav lang={lang} active="artifacts" langPaths={langPaths} />

  <section class="page-header">
    <h1>{strings.artifacts.title}</h1>
    <p>{strings.artifacts.desc}</p>
  </section>

  {artifacts.length === 0 ? (
    <div class="empty-state">{strings.artifacts.empty}</div>
  ) : (
    <>
      <div class="filter-bar">
        <input type="search" id="artifactSearch" placeholder={strings.artifacts.filterPlaceholder} />
        <select id="artifactModelFilter">
          <option value="">{strings.artifacts.allModels}</option>
          {models.map((m) => <option value={m}>{m}</option>)}
        </select>
      </div>

      <div class="artifacts-grid" id="artifactsGrid">
        {artifacts.map((a) => (
          <div class="artifact-item" data-model={a.data.model} data-search={`${resolveLocalized(a.data.title, lang)} ${a.data.tags.join(' ')}`.toLowerCase()}>
            <ArtifactCard
              lang={lang}
              slug={a.id}
              title={resolveLocalized(a.data.title, lang)}
              description={a.data.description ? resolveLocalized(a.data.description, lang) : undefined}
              model={a.data.model}
              date={a.data.date}
              tags={a.data.tags}
              requiresClaude={a.data.requiresClaude}
            />
          </div>
        ))}
      </div>
      <div class="empty-state" id="noResults" style="display:none;">{strings.artifacts.noResults}</div>
    </>
  )}

  <Footer lang={lang} />
</BaseLayout>

<script>
  const search = document.getElementById('artifactSearch') as HTMLInputElement | null;
  const modelFilter = document.getElementById('artifactModelFilter') as HTMLSelectElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.artifact-item'));
  const noResults = document.getElementById('noResults');

  function applyFilter() {
    const q = (search?.value || '').trim().toLowerCase();
    const model = modelFilter?.value || '';
    let visible = 0;
    for (const item of items) {
      const matchesModel = !model || item.dataset.model === model;
      const matchesSearch = !q || (item.dataset.search || '').includes(q);
      const show = matchesModel && matchesSearch;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
  }

  search?.addEventListener('input', applyFilter);
  modelFilter?.addEventListener('change', applyFilter);
</script>

<style>
  .filter-bar {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin: 28px 0 32px;
  }
  /* Underlined fields, like a form printed on newsprint. */
  .filter-bar input,
  .filter-bar select {
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 2px;
    border: none;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
  }
  .filter-bar input { flex: 1; min-width: 200px; }
  .filter-bar input::placeholder { color: var(--ink-soft); }
  .filter-bar input:focus, .filter-bar select:focus { outline: none; border-bottom: 2px solid var(--accent); }
  .filter-bar select option { background: var(--bg); color: var(--ink); }

  .artifacts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 36px;
  }

  @media (max-width: 900px) {
    .artifacts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .artifacts-grid { grid-template-columns: minmax(0, 1fr); }
    .filter-bar { flex-direction: column; gap: 12px; }
  }
</style>
