---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';
import { resolveLocalized } from '../../lib/artifacts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);

// The front page is one dated feed of posts and artifacts, laid out like a
// newspaper purely by position: 1st is the lead story, 2nd–3rd are medium,
// the rest a compact list. Nothing is hand-picked, so publishing never needs
// a "featured" flag. Projects have no date — they get a fixed rubric below.
interface FeedItem {
  kind: 'post' | 'artifact';
  href: string;
  title: string;
  desc?: string;
  image?: string;
  date: Date;
  model?: string;
}

const posts: FeedItem[] = (await getCollection('posts'))
  .filter((entry) => entry.slug.endsWith(`/${lang}`))
  .map((entry) => ({
    kind: 'post',
    href: `/${lang}/posts/${entry.slug.split('/')[0]}/`,
    title: entry.data.title,
    desc: entry.data.excerpt,
    image: entry.data.coverImage,
    date: entry.data.createdAt,
  }));

const artifacts: FeedItem[] = (await getCollection('artifacts')).map((a) => ({
  kind: 'artifact',
  href: `/${lang}/artifacts/${a.id}/`,
  title: resolveLocalized(a.data.title, lang),
  desc: a.data.description ? resolveLocalized(a.data.description, lang) : undefined,
  date: a.data.date,
  model: a.data.model,
}));

const feed = [...posts, ...artifacts].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const [lead, ...others] = feed;
const secondary = others.slice(0, 2);
const latest = others.slice(2, 8);

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 3);

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/`])) as Record<Lang, string>;

const dateFmt = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' });

const kicker = (item: FeedItem) =>
  item.kind === 'post'
    ? strings.home.kickerPost
    : `${strings.home.kickerArtifact}${item.model ? ` · ${item.model}` : ''}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammadjon Ibrohimov',
  alternateName: 'miuceo',
  url: 'https://muhammadjon.me/',
  sameAs: ['https://t.me/muhammadibrohimov_ceo', 'https://github.com/miuceo'],
  jobTitle: 'AI/ML Engineer',
};
---

<BaseLayout
  lang={lang}
  title={strings.meta.siteTitle}
  description={strings.meta.siteDescription}
  canonicalPath={`/${lang}/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="none" langPaths={langPaths} front />

  <main class="front-page">
    <section class="hero">
      <h1>{strings.hero.titlePre} <em>{strings.hero.titleAccent1}</em> {strings.hero.titleMid} <em>{strings.hero.titleAccent2}</em></h1>
      <p class="hero-desc">{strings.hero.desc}</p>
      <div class="hero-cta">
        <a href={`/${lang}/projects/`} class="btn">{strings.hero.ctaProjects}</a>
        <a href={`/${lang}/contact/`} class="btn ghost">{strings.hero.ctaContact}</a>
        <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener" class="btn ghost">{strings.hero.ctaTelegram}</a>
      </div>
    </section>

    {lead ? (
      <div class:list={['front-grid', { 'text-lead': !lead.image }]}>
        <a href={lead.href} class:list={['story lead', { 'no-image': !lead.image }]}>
          <span class:list={['kicker', { red: lead.kind === 'artifact' }]}>{kicker(lead)}</span>
          <h2><span class="hl">{lead.title}</span></h2>
          {lead.image && (
            <figure class="story-img"><img src={lead.image} alt="" loading="eager" /></figure>
          )}
          {lead.desc && <p class="story-desc">{lead.desc}</p>}
          <span class="story-meta">{dateFmt.format(lead.date)}</span>
        </a>

        <div class="col-secondary">
          {secondary.map((item) => (
            <a href={item.href} class="story medium">
              {item.image && (
                <figure class="story-img"><img src={item.image} alt="" loading="lazy" /></figure>
              )}
              <span class:list={['kicker', { red: item.kind === 'artifact' }]}>{kicker(item)}</span>
              <h3><span class="hl">{item.title}</span></h3>
              {item.desc && <p class="story-desc">{item.desc}</p>}
              <span class="story-meta">{dateFmt.format(item.date)}</span>
            </a>
          ))}
        </div>

        <aside class="col-side">
          {latest.length > 0 && (
            <section class="latest">
              <h2 class="rubric">{strings.home.latest}</h2>
              <ol>
                {latest.map((item) => (
                  <li>
                    <a href={item.href}>
                      <span class="latest-title hl">{item.title}</span>
                      <span class:list={['latest-meta', { red: item.kind === 'artifact' }]}>
                        {item.kind === 'artifact' ? strings.home.kickerArtifact : strings.home.kickerPost} · {dateFmt.format(item.date)}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )}

        </aside>
      </div>
    ) : (
      <div class="empty-state">{strings.home.noPosts}</div>
    )}

    {projects.length > 0 && (
      <section class="projects-rubric">
        <div class="rubric-head">
          <h2 class="rubric">{strings.projects.title}</h2>
          <a href={`/${lang}/projects/`} class="rubric-more">{strings.home.viewAllProjects}</a>
        </div>
        <div class="projects-row">
          {projects.map((p) => (
            <a href={`/${lang}/projects/`} class="project">
              <h3><span class="hl">{p.data.title[lang]}</span></h3>
              <p>{p.data.description[lang]}</p>
              {p.data.tags.length > 0 && <span class="project-tags">{p.data.tags.slice(0, 4).join(' · ')}</span>}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .front-page { padding-top: 28px; }

  /* The hero stays as the front page's banner headline — same words as
     before, set like a newspaper's top story across the full width. */
  .hero {
    text-align: center;
    padding: 44px 0 52px;
    margin-bottom: 32px;
    border-bottom: 3px double var(--rule);
  }
  .hero h1 {
    font-weight: 900;
    font-size: clamp(36px, 5.6vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    max-width: 1120px;
    margin: 0 auto;
    text-wrap: balance;
  }
  .hero h1 em { font-style: italic; font-weight: 700; color: var(--accent); }
  .hero-desc {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 680px;
    margin: 22px auto 0;
  }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }

  /* Three newspaper columns separated by hairline rules. */
  .front-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
  }
  .front-grid > * { padding: 0 24px; }
  .front-grid > *:first-child { padding-left: 0; }
  .front-grid > *:last-child { padding-right: 0; }
  .front-grid > * + * { border-left: 1px solid var(--line); }

  .story { display: flex; flex-direction: column; gap: 8px; color: var(--ink); }
  .story h2, .story h3 { line-height: 1.12; }
  .lead h2 { font-size: 40px; font-weight: 700; letter-spacing: -0.01em; }
  .lead.no-image h2 { font-size: 50px; }
  .medium h3 { font-size: 21px; }

  .story-img { margin: 6px 0 4px; overflow: hidden; background: var(--bg-3); }
  .story-img img {
    display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover;
    transition: transform .8s ease;
  }
  .medium .story-img { margin: 0 0 4px; }
  .story:hover .story-img img { transform: scale(1.02); }

  .story-desc {
    font-family: var(--font-body);
    color: var(--ink-soft);
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lead .story-desc { font-size: 18px; color: var(--ink); -webkit-line-clamp: 5; }
  .lead.no-image .story-desc { font-size: 20px; }
  .story-meta {
    font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-soft);
  }

  .col-secondary { display: flex; flex-direction: column; }
  .col-secondary .story + .story { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line); }

  /* Section heads: small tracked caps on a heavy rule. */
  .rubric {
    font-family: var(--font-sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink);
    padding-top: 8px; border-top: 2px solid var(--rule); margin: 0 0 4px;
  }

  .latest ol { list-style: none; margin: 0; padding: 0; }
  .latest li + li { border-top: 1px solid var(--line); }
  .latest a { display: flex; flex-direction: column; gap: 4px; padding: 12px 0; }
  .latest-title { font-family: var(--font-display); font-weight: 700; font-size: 16px; line-height: 1.25; color: var(--ink); }
  .latest-meta {
    font-family: var(--font-sans); font-size: 10.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  .latest-meta.red { color: var(--accent); }


  .projects-rubric { margin-top: 48px; border-top: 3px double var(--rule); padding-top: 4px; }
  .rubric-head { display: flex; justify-content: space-between; align-items: baseline; }
  .rubric-head .rubric { border-top: none; }
  .rubric-more {
    font-family: var(--font-sans); font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft);
  }
  .rubric-more:hover { color: var(--accent); }
  .projects-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 14px; }
  .project { padding: 0 24px; display: flex; flex-direction: column; gap: 8px; color: var(--ink); }
  .project:first-child { padding-left: 0; }
  .project:last-child { padding-right: 0; }
  .project + .project { border-left: 1px solid var(--line); }
  .project h3 { font-size: 20px; line-height: 1.2; }
  .project p { font-family: var(--font-body); font-size: 15px; line-height: 1.5; color: var(--ink-soft); margin: 0; }
  .project-tags {
    font-family: var(--font-sans); font-size: 10.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent);
  }

  /* A lead with no picture is short, so the two medium stories move up under
     it as a row instead of leaving a tall empty column beside them. */
  .front-grid.text-lead { grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr); }
  .text-lead > .lead { grid-column: 1; grid-row: 1; padding: 0 24px 24px 0; border-bottom: 1px solid var(--line); }
  .text-lead > .col-secondary {
    grid-column: 1; grid-row: 2; flex-direction: row; align-items: flex-start;
    border-left: none; padding: 24px 24px 0 0;
  }
  .text-lead > .col-secondary .story { flex: 1 1 0; min-width: 0; }
  .text-lead > .col-secondary .story + .story { margin: 0 0 0 24px; padding: 0 0 0 24px; border-top: none; border-left: 1px solid var(--line); }
  .text-lead > .col-side { grid-column: 2; grid-row: 1 / 3; }

  .empty-state { text-align: center; padding: 60px 20px; color: var(--ink-soft); font-family: var(--font-body); font-style: italic; }

  /* Tablet: lead spans the top, the other two columns sit side by side. */
  @media (max-width: 1000px) {
    .front-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .front-grid > .lead { grid-column: 1 / -1; padding: 0 0 24px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
    .front-grid > .col-secondary { padding-left: 0; border-left: none; }
    .front-grid.text-lead { grid-template-columns: minmax(0, 1fr); }
    .text-lead > .lead, .text-lead > .col-secondary, .text-lead > .col-side { grid-column: 1; grid-row: auto; padding-right: 0; }
    .text-lead > .col-side { border-left: none; padding-left: 0; margin-top: 28px; }
    .text-lead > .col-secondary { padding-top: 0; }
  }
  @media (max-width: 640px) {
    .front-page { padding-top: 20px; }
    .hero { padding: 24px 0 32px; margin-bottom: 24px; }
    .hero-desc { font-size: 17px; margin-top: 16px; }
    .hero-cta { margin-top: 22px; }
    .front-grid { grid-template-columns: minmax(0, 1fr); }
    .front-grid > * { padding: 0; border-left: none !important; }
    .front-grid > .col-side { margin-top: 28px; }
    .text-lead > .col-secondary { flex-direction: column; }
    .text-lead > .col-secondary .story + .story { margin: 20px 0 0; padding: 20px 0 0; border-left: none; border-top: 1px solid var(--line); }
    .lead h2 { font-size: 30px; }
    .lead.no-image h2 { font-size: 34px; }
    .lead .story-desc { font-size: 17px; }
    .projects-row { grid-template-columns: minmax(0, 1fr); }
    .project { padding: 0 !important; border-left: none !important; }
    .project + .project { margin-top: 18px; padding-top: 18px !important; border-top: 1px solid var(--line); }
  }
</style>
