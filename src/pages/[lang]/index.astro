---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);

const allPosts = await getCollection('posts');
const postsForLang = allPosts
  .filter((entry) => entry.slug.endsWith(`/${lang}`))
  .map((entry) => ({ slug: entry.slug.split('/')[0], data: entry.data }))
  .sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

// 1. Eng oxirgi bitta post (Alohida katta chiqadi)
const [latest, ...rest] = postsForLang;

// 2. Keyingi 4 ta post (Grid kartochkalar)
const gridPosts = rest.slice(0, 4);

// 3. Qolganlari (List ro'yxat)
const listPosts = rest.slice(4, 24);
const hasMorePosts = rest.length > 24;

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/`])) as Record<Lang, string>;

const dateFmt = new Intl.DateTimeFormat(lang, {
  year: 'numeric', month: 'short', day: 'numeric'
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammadjon Ibrohimov',
  alternateName: 'miuceo',
  url: 'https://muhammadjon.me/',
  sameAs: ['https://t.me/muhammadibrohimov_ceo', 'https://github.com/miuceo'],
  jobTitle: 'AI/ML Engineer',
};
---

<BaseLayout
  lang={lang}
  title={strings.meta.siteTitle}
  description={strings.meta.siteDescription}
  canonicalPath={`/${lang}/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="posts" langPaths={langPaths} />

  <main class="page-container">
    <section class="hero">
      <h1>{strings.hero.titlePre} <em>{strings.hero.titleAccent1}</em> {strings.hero.titleMid} <em>{strings.hero.titleAccent2}</em></h1>
      <p class="hero-desc">{strings.hero.desc}</p>
    </section>

    <!-- 1. Eng oxirgi post -->
    <div class="section-label" id="latest-posts">{strings.home.latestPost}</div>
    {latest ? (
      <a href={`/${lang}/posts/${latest.slug}/`} class="featured-post">
        <div class="featured-text">
          <h2>{latest.data.title}</h2>
          <p>{latest.data.excerpt}</p>
          <span class="read-more">{strings.home.continueReading} &rarr;</span>
        </div>
        {latest.data.coverImage ? (
          <div class="featured-image">
            <img src={latest.data.coverImage} alt={latest.data.title} />
          </div>
        ) : (
          <div class="featured-image placeholder"></div>
        )}
      </a>
    ) : (
      <div class="empty-state">{strings.home.noPosts}</div>
    )}

    <!-- 2. Keyingi 4 ta post kartochkada -->
    {gridPosts.length > 0 && (
      <>
        <div class="section-label" id="latest-posts">So'nggi postlar</div>
        <div class="posts-grid">
          {gridPosts.map((p) => (
            <PostCard lang={lang} slug={p.slug} title={p.data.title} excerpt={p.data.excerpt} createdAt={p.data.createdAt} />
          ))}
        </div>
      </>
    )}

    <!-- 3. Keyingi postlar ro'yxati -->
    {listPosts.length > 0 && (
      <div class="list-section">
        <div class="section-label">Oldingi postlar</div>
        <div class="posts-list">
          {listPosts.map((p) => (
            <a href={`/${lang}/posts/${p.slug}/`} class="list-item">
              <span class="list-title">{p.data.title}</span>
              <span class="list-date">{dateFmt.format(p.data.createdAt)}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Barcha postlarga o'tish tugmasi -->
    {hasMorePosts && (
      <div class="view-all-wrapper">
        <a href={`/${lang}/posts/`} class="btn ghost view-all-btn">Barcha postlarni ko'rish</a>
      </div>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hero { 
    padding: 120px 0 100px; 
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  .hero h1 { 
    font-size: 52px; 
    line-height: 1.15; 
    color: var(--ink);
    margin: 0 0 24px; 
  }
  .hero h1 em { 
    font-size: inherit;
    font-style: italic; 
    color: var(--accent); 
  }
  .hero-desc { 
    font-size: 18px; 
    line-height: 1.6; 
    color: var(--ink-soft); 
    max-width: 600px;
    margin: 0 auto;
  }

  /* Featured Post (Oxirgi post) */
  .featured-post {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    min-height: 340px;
    margin-bottom: 100px;
    text-decoration: none;
    transition: border-color .3s ease, background-color .3s ease;
  }
  .featured-post:hover {
    border-color: var(--ink-soft);
    background: var(--bg-2);
  }
  .featured-text {
    padding: 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .featured-text h2 {
    font-size: 32px;
    font-weight: 500;
    margin: 0 0 16px;
    line-height: 1.25;
    color: var(--ink);
    font-family: var(--font-serif);
  }
  .featured-text p {
    font-size: 15px;
    color: var(--ink-soft);
    margin: 0 0 32px;
    line-height: 1.6;
  }
  .featured-image {
    background: var(--bg-3);
    width: 100%;
    height: 100%;
  }
  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .featured-image.placeholder {
    background: var(--bg-2);
  }
  .read-more {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-bottom: 32px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  /* Grid (Top 4) */
  .posts-grid { 
    display: grid; 
    grid-template-columns: repeat(2, 1fr); 
    gap: 32px; 
    margin-bottom: 100px; 
  }

  /* List (Next 20) */
  .list-section {
    margin-bottom: 80px;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
  }
  .list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line-soft);
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .list-item:hover {
    background-color: var(--bg-2);
    padding-left: 12px;
    padding-right: 12px;
    margin-left: -12px;
    margin-right: -12px;
    border-radius: 8px;
    border-bottom-color: transparent;
  }
  .list-title {
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
  }
  .list-item:hover .list-title {
    color: var(--accent);
  }
  .list-date {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .view-all-wrapper {
    text-align: center;
    margin-bottom: 100px;
  }

  .empty-state { 
    grid-column: 1/-1; 
    text-align: center; 
    padding: 60px 20px; 
    color: var(--ink-soft); 
    font-style: italic; 
    font-size: 15px; 
  }

  @media (max-width: 860px) { 
    .featured-post { grid-template-columns: 1fr; } 
    .featured-image { min-height: 280px; order: -1; } 
    .featured-content { padding: 40px; } 
    .posts-grid { grid-template-columns: 1fr; gap: 24px; } 
  }
  @media (max-width: 640px) {
    .page-container { padding: 0 20px; }
    .hero { padding: 80px 0; }
    .hero h1 { font-size: 36px; }
    .hero-desc { font-size: 16px; }
    .featured-content h2 { font-size: 28px; }
    .list-item { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
