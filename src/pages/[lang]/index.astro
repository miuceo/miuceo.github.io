---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import ArtifactCard from '../../components/ArtifactCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';
import { resolveLocalized } from '../../lib/artifacts';
import { getStars } from '../../lib/github';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);

interface FeedPost {
  kind: 'post';
  slug: string;
  title: string;
  desc?: string;
  image?: string;
  date: Date;
}

interface FeedArtifact {
  kind: 'artifact';
  slug: string;
  title: string;
  desc?: string;
  date: Date;
  model: string;
  tags: string[];
  requiresClaude: boolean;
}

type FeedItem = FeedPost | FeedArtifact;

const posts: FeedPost[] = (await getCollection('posts'))
  .filter((entry) => entry.slug.endsWith(`/${lang}`))
  .map((entry) => ({
    kind: 'post',
    slug: entry.slug.split('/')[0],
    title: entry.data.title,
    desc: entry.data.excerpt,
    image: entry.data.coverImage,
    date: entry.data.createdAt,
  }));

const artifacts: FeedArtifact[] = (await getCollection('artifacts')).map((a) => ({
  kind: 'artifact',
  slug: a.id,
  title: resolveLocalized(a.data.title, lang),
  desc: a.data.description ? resolveLocalized(a.data.description, lang) : undefined,
  date: a.data.date,
  model: a.data.model,
  tags: a.data.tags,
  requiresClaude: a.data.requiresClaude,
}));

const feed: FeedItem[] = [...posts, ...artifacts]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 7);

const allProjects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
const projects = allProjects.slice(0, 3);
const featuredProject = allProjects[0];

const starsByRepo = new Map(
  await Promise.all(
    projects
      .filter((p) => p.data.githubRepo)
      .map(async (p) => [p.data.githubRepo as string, await getStars(p.data.githubRepo as string)] as const)
  )
);

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/`])) as Record<Lang, string>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammadjon Ibrohimov',
  alternateName: 'miuceo',
  url: 'https://muhammadjon.me/',
  sameAs: ['https://t.me/muhammadibrohimov_ceo', 'https://github.com/miuceo'],
  jobTitle: 'AI/ML Engineer',
};
---

<BaseLayout
  lang={lang}
  title={strings.meta.siteTitle}
  description={strings.meta.siteDescription}
  canonicalPath={`/${lang}/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="none" langPaths={langPaths} front />

  <main class="front-page">
    <section class="hero">
      <div class="hero-content">
        <span class="hero-eyebrow">
          <span class="hero-prompt-symbol" aria-hidden="true">&gt;_</span>
          <span>{strings.hero.prompt}</span>
        </span>
        <h1>
          {strings.hero.titlePre} <span class="hero-accent-cobalt">{strings.hero.titleAccent1}</span> {strings.hero.titleMid} <span class="hero-accent-coral">{strings.hero.titleAccent2}</span>
        </h1>
        <p class="hero-desc">{strings.hero.desc}</p>
        <div class="hero-cta">
          <a href={`/${lang}/projects/`} class="btn btn-primary">{strings.hero.ctaProjects}</a>
          <a href={`/${lang}/contact/`} class="btn btn-ghost">{strings.hero.ctaContact}</a>
          <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener" class="btn btn-ghost">
            {strings.hero.ctaTelegram}
          </a>
        </div>
      </div>

      <div class="hero-bento">
        {/* Top Bento Card: Status + Quick Search */}
        <div class="bento-card bento-status">
          <div class="bento-status-left">
            <div class="bento-status-eyebrow">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="status-label">{strings.hero.bento.statusLabel}</span>
            </div>
            <div class="bento-status-value">{strings.hero.bento.statusValue}</div>
          </div>
          <button type="button" class="bento-cmdk" data-open-cmdk aria-label={strings.hero.bento.quickSearch}>
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="cmdk-label">{strings.hero.bento.quickSearch}</span>
            <kbd>Ctrl K</kbd>
          </button>
        </div>

        {/* Middle Bento Row: 3 mini stat cards */}
        <div class="bento-stats">
          <a href={`/${lang}/projects/`} class="bento-stat stat-projects">
            <span class="bento-stat-num num-projects">{allProjects.length}</span>
            <span class="bento-stat-label">{strings.hero.bento.statProjects}</span>
          </a>
          <a href={`/${lang}/posts/`} class="bento-stat stat-posts">
            <span class="bento-stat-num num-posts">{posts.length}</span>
            <span class="bento-stat-label">{strings.hero.bento.statPosts}</span>
          </a>
          <a href={`/${lang}/artifacts/`} class="bento-stat stat-artifacts">
            <span class="bento-stat-num num-artifacts">{artifacts.length}</span>
            <span class="bento-stat-label">{strings.hero.bento.statArtifacts}</span>
          </a>
        </div>

        {/* Bottom Bento Card: Featured Project + Neuron UZ pill */}
        <div class="bento-card bento-featured">
          <div class="bento-featured-pills">
            <span class="bento-pill-featured">{strings.hero.bento.featuredLabel}</span>
            <a href="/neuron-uz/" class="bento-pill-quick" title="Neuron UZ">
              <span>Neuron UZ</span>
              <span class="pill-arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <a
            href={featuredProject?.data.url || `/${lang}/projects/`}
            class="bento-featured-body"
            target={featuredProject?.data.external ? '_blank' : undefined}
            rel={featuredProject?.data.external ? 'noopener noreferrer' : undefined}
          >
            <div class="bento-featured-title-wrap">
              <h3 class="bento-featured-title">
                {featuredProject ? featuredProject.data.title[lang] : ''}
              </h3>
              <svg class="featured-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
            <p class="bento-featured-desc">
              {featuredProject ? featuredProject.data.description[lang] : ''}
            </p>
          </a>
        </div>
      </div>
    </section>

    <section class="latest-section">
      <div class="section-head">
        <h2 class="section-heading">{strings.home.latest}</h2>
        <div class="section-links">
          <a href={`/${lang}/posts/`} class="more-link">{strings.home.viewAllPosts}</a>
          <a href={`/${lang}/artifacts/`} class="more-link">{strings.home.viewAllArtifacts}</a>
        </div>
      </div>

      {feed.length > 0 ? (
        <div class="latest-grid">
          {feed.map((item, idx) => (
            <div class="grid-item">
              {item.kind === 'post' ? (
                <PostCard
                  lang={lang}
                  slug={item.slug}
                  title={item.title}
                  excerpt={item.desc ?? ''}
                  createdAt={item.date}
                  coverImage={item.image}
                  showKind
                  priority={idx === 0}
                />
              ) : (
                <ArtifactCard
                  lang={lang}
                  slug={item.slug}
                  title={item.title}
                  description={item.desc}
                  model={item.model}
                  date={item.date}
                  tags={item.tags}
                  requiresClaude={item.requiresClaude}
                  showKind
                />
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">{strings.home.noPosts}</div>
      )}
    </section>

    {projects.length > 0 && (
      <section class="projects-section">
        <div class="section-head">
          <h2 class="section-heading">{strings.projects.title}</h2>
          <a href={`/${lang}/projects/`} class="more-link">{strings.home.viewAllProjects}</a>
        </div>
        <div class="projects-grid">
          {projects.map((p) => (
            <div class="grid-item">
              <ProjectCard
                lang={lang}
                title={p.data.title[lang]}
                description={p.data.description[lang]}
                problem={p.data.problem?.[lang]}
                solution={p.data.solution?.[lang]}
                result={p.data.result?.[lang]}
                tags={p.data.tags}
                status={p.data.status}
                url={p.data.url}
                external={p.data.external}
                stars={p.data.githubRepo ? starsByRepo.get(p.data.githubRepo) : undefined}
              />
            </div>
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script is:inline>
  (function () {
    var cmdkBtn = document.querySelector('[data-open-cmdk]');
    if (cmdkBtn) {
      cmdkBtn.addEventListener('click', function () {
        window.dispatchEvent(new CustomEvent('open-cmdk'));
        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true }));
      });
    }
  })();
</script>

<style>
  .front-page {
    padding-bottom: var(--space-6);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6) 0 var(--space-6);
    margin-bottom: var(--space-5);
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent-1-text);
    background: color-mix(in srgb, var(--accent-1) 12%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent-1) 40%, var(--mid));
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent-1) 20%, transparent);
  }
  .hero-prompt-symbol {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--accent-2);
  }
  .hero h1 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--text);
    margin: 0 0 var(--space-4);
  }
  .hero-accent-cobalt {
    color: var(--accent-1-text);
  }
  .hero-accent-coral {
    color: var(--accent-2);
  }
  .hero-desc {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.65;
    max-width: 62ch;
    color: var(--text);
    margin: 0 0 var(--space-4);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .hero-cta .btn {
    min-height: 48px;
    padding: 12px 24px;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Bento Showcase */
  .hero-bento {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  .bento-card {
    background: var(--surface);
    border: 1px solid var(--mid);
    border-radius: var(--radius-card);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .bento-card:hover {
    border-color: var(--accent-1);
    box-shadow: 0 0 16px color-mix(in srgb, var(--accent-1) 20%, transparent);
  }

  /* Top Bento: Status */
  .bento-status {
    padding: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .bento-status-left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .bento-status-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-1-text);
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent-3);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent-3) 80%, transparent);
    display: inline-block;
    flex-shrink: 0;
    animation: status-pulse 2.2s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 8px color-mix(in srgb, var(--accent-3) 80%, transparent);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.9);
      box-shadow: 0 0 3px color-mix(in srgb, var(--accent-3) 35%, transparent);
    }
  }
  .bento-status-value {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .bento-cmdk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg);
    border: 1px solid var(--mid);
    border-radius: var(--radius-ui);
    padding: 6px 10px;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }
  .bento-cmdk:hover {
    border-color: var(--accent-1);
    color: var(--accent-1-text);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 25%, transparent);
  }
  .bento-cmdk .search-icon {
    color: var(--mid);
    transition: color 0.2s ease;
  }
  .bento-cmdk:hover .search-icon {
    color: var(--accent-1);
  }
  .bento-cmdk kbd {
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--surface);
    border: 1px solid var(--mid);
    color: var(--text);
    line-height: 1.2;
  }

  /* Middle Bento: Stats */
  .bento-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .bento-stat {
    background: var(--surface);
    border: 1px solid var(--mid);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .bento-stat:hover {
    color: var(--text);
    text-shadow: none;
    transform: translateY(-2px);
  }
  .bento-stat.stat-projects:hover {
    border-color: var(--accent-1);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent-1) 30%, transparent);
  }
  .bento-stat.stat-posts:hover {
    border-color: var(--accent-2);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent-2) 30%, transparent);
  }
  .bento-stat.stat-artifacts:hover {
    border-color: var(--accent-3);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent-3) 30%, transparent);
  }
  .bento-stat-num {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .bento-stat-num.num-projects {
    color: var(--accent-1-text);
  }
  .bento-stat-num.num-posts {
    color: var(--accent-2);
  }
  .bento-stat-num.num-artifacts {
    color: var(--accent-3);
  }
  .bento-stat-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
  }

  /* Bottom Bento: Featured */
  .bento-featured {
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
  }
  .bento-featured-pills {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    position: relative;
    z-index: 2;
  }
  .bento-pill-featured {
    display: inline-block;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--accent-1);
    color: var(--on-accent-1);
  }
  .bento-pill-quick {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    background: var(--accent-2);
    color: var(--on-accent-2);
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .bento-pill-quick:hover {
    color: var(--on-accent-2);
    text-shadow: none;
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent-2) 65%, transparent);
    transform: translateY(-1px);
  }
  .bento-pill-quick .pill-arrow {
    font-size: 12px;
  }
  .bento-featured-body {
    display: block;
    text-decoration: none;
    color: var(--text);
    position: relative;
  }
  .bento-featured-body:hover {
    color: var(--text);
    text-shadow: none;
  }
  .bento-featured-body::after {
    content: '';
    position: absolute;
    inset: -38px -16px -12px -16px;
    z-index: 1;
  }
  .bento-featured-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }
  .bento-featured-title {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }
  .bento-featured:hover .bento-featured-title {
    color: var(--accent-1-text);
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 45%, transparent);
  }
  .featured-arrow {
    color: var(--accent-1-text);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .bento-featured:hover .featured-arrow {
    color: var(--accent-1);
    transform: translate(2px, -2px);
  }
  .bento-featured-desc {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: var(--text);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .section-heading {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
    margin: 0;
  }
  .section-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .more-link {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-1-text);
    text-decoration: underline;
  }

  .latest-section {
    margin-bottom: var(--space-6);
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .latest-grid > :first-child {
    grid-column: span 2;
  }

  .projects-section {
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    margin-top: var(--space-6);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }

  @media (min-width: 769px) {
    .latest-grid > :first-child :global(.post-card.has-image) {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-5);
      align-items: center;
    }
    .latest-grid > :first-child :global(.post-card.has-image .card-image) {
      margin-bottom: 0;
      aspect-ratio: 16 / 10;
      max-height: 280px;
    }
    .latest-grid > :first-child :global(.post-card.has-image .card-image img) {
      width: 100%;
      height: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
    }
    .latest-grid > :first-child :global(.post-card.has-image .card-body) {
      justify-content: center;
      flex-grow: 0;
    }
    .latest-grid > :first-child :global(.post-card.has-image .card-excerpt) {
