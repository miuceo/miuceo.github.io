---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';
import { resolveLocalized } from '../../lib/artifacts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);

const allPosts = await getCollection('posts');
const postsForLang = allPosts
  .filter((entry) => entry.slug.endsWith(`/${lang}`))
  .map((entry) => ({ slug: entry.slug.split('/')[0], data: entry.data }))
  .sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

// 1. Eng oxirgi bitta post (Alohida katta chiqadi)
const [latest, ...rest] = postsForLang;

// 2. Undan keyingi 3 ta post — ixcham "So'nggi postlar" ustunida
const recentPosts = rest.slice(0, 3);

// 3. Loyihalar va artifaktlar — har biridan eng so'nggi 3 tasi
const recentProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 3);
const recentArtifacts = (await getCollection('artifacts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/`])) as Record<Lang, string>;

const dateFmt = new Intl.DateTimeFormat(lang, {
  year: 'numeric', month: 'long', day: 'numeric'
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammadjon Ibrohimov',
  alternateName: 'miuceo',
  url: 'https://muhammadjon.me/',
  sameAs: ['https://t.me/muhammadibrohimov_ceo', 'https://github.com/miuceo'],
  jobTitle: 'AI/ML Engineer',
};
---

<BaseLayout
  lang={lang}
  title={strings.meta.siteTitle}
  description={strings.meta.siteDescription}
  canonicalPath={`/${lang}/`}
  hreflangPaths={langPaths}
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="none" langPaths={langPaths} />

  <div class="hero-pin">
    <section class="hero">
      <h1>{strings.hero.titlePre} <em>{strings.hero.titleAccent1}</em> {strings.hero.titleMid} <em>{strings.hero.titleAccent2}</em></h1>
      <p class="hero-desc">{strings.hero.desc}</p>
      <div class="hero-cta">
        <a href={`/${lang}/projects/`} class="btn">{strings.hero.ctaProjects}</a>
        <a href={`/${lang}/contact/`} class="btn ghost">{strings.hero.ctaContact}</a>
        <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener" class="btn ghost">{strings.hero.ctaTelegram}</a>
      </div>
    </section>
    <Footer lang={lang} />
  </div>

  <div class="content-overlay">
  <main class="page-container">
    <!-- 1. Eng oxirgi post -->
    <div class="section-label" id="latest-posts">{strings.home.latestPost}</div>
    {latest ? (
      <a href={`/${lang}/posts/${latest.slug}/`} class="featured-post">
        <div class="featured-text">
          <span class="featured-date">{dateFmt.format(latest.data.createdAt)}</span>
          <h2>{latest.data.title}</h2>
          <p>{latest.data.excerpt}</p>
          <span class="read-more">{strings.home.continueReading}</span>
        </div>
        {latest.data.coverImage ? (
          <div class="featured-image">
            <img src={latest.data.coverImage} alt={latest.data.title} />
          </div>
        ) : (
          <div class="featured-image placeholder"></div>
        )}
      </a>
    ) : (
      <div class="empty-state">{strings.home.noPosts}</div>
    )}

    <!-- 2. Loyihalar / Artifaktlar / So'nggi postlar — uchtasi teng, ixcham ustunlarda,
         har biri o'z rangi bilan ajralib turadi -->
    <div class="hub">
      <div class="hub-col" data-accent="projects">
        <div class="hub-head">
          <h2>{strings.projects.title}</h2>
          <a href={`/${lang}/projects/`} class="hub-more">{strings.home.viewAllProjects}</a>
        </div>
        <div class="hub-list">
          {recentProjects.map((p) => (
            <a href={`/${lang}/projects/`} class="hub-item">
              <span class="hub-item-title">{p.data.title[lang]}</span>
              <span class="hub-item-desc">{p.data.description[lang]}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="hub-col" data-accent="artifacts">
        <div class="hub-head">
          <h2>{strings.artifacts.title}</h2>
          <a href={`/${lang}/artifacts/`} class="hub-more">{strings.home.viewAllArtifacts}</a>
        </div>
        <div class="hub-list">
          {recentArtifacts.map((a) => (
            <a href={`/${lang}/artifacts/${a.id}/`} class="hub-item">
              <span class="hub-item-title">{resolveLocalized(a.data.title, lang)}</span>
              <span class="hub-item-desc">{a.data.description ? resolveLocalized(a.data.description, lang) : a.data.model}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="hub-col" data-accent="posts">
        <div class="hub-head">
          <h2>{strings.home.recentPosts}</h2>
          <a href={`/${lang}/posts/`} class="hub-more">{strings.home.viewAllPosts}</a>
        </div>
        <div class="hub-list">
          {recentPosts.map((p) => (
            <a href={`/${lang}/posts/${p.slug}/`} class="hub-item">
              <span class="hub-item-title">{p.data.title}</span>
              <span class="hub-item-desc">{dateFmt.format(p.data.createdAt)}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 56px 40px 0;
  }

  /* Pinned behind the fixed Nav, filling the viewport it started in — the
     rest of the page (.content-overlay) scrolls up over it, so the hero
     (and its footer) stay put until fully covered. Pure CSS: no scroll
     listeners, no motion to disable under prefers-reduced-motion, readable
     with JS off. Column layout: hero grows to fill the space above the
     footer and centers itself within it; the footer keeps its normal
     height and sits flush at the bottom of the viewport. */
  .hero-pin {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    z-index: 1;
    overflow: hidden;
    background: var(--bg);
  }
  .content-overlay {
    position: relative;
    z-index: 2;
    background: var(--bg);
    margin-top: calc(100vh - var(--nav-height));
    margin-top: calc(100dvh - var(--nav-height));
    border-radius: 28px 28px 0 0;
    box-shadow: 0 -32px 60px rgba(0, 0, 0, 0.35);
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: 0 40px;
  }
  .hero-pin :global(footer) {
    flex-shrink: 0;
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    padding: 20px 32px;
  }
  .hero h1 { 
    font-size: 52px; 
    line-height: 1.15; 
    color: var(--ink);
    margin: 0 0 24px; 
  }
  .hero h1 em { 
    font-size: inherit;
    font-style: italic; 
    color: var(--accent); 
  }
  .hero-desc {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 600px;
    margin: 0 auto;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  /* Featured Post (Oxirgi post) — ixcham, lekin bosh sahifaning eng keng elementi */
  .featured-post {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    min-height: 260px;
    margin-bottom: 56px;
    text-decoration: none;
    transition: border-color .3s ease, background-color .3s ease;
  }
  .featured-post:hover {
    border-color: var(--ink-soft);
    background: var(--bg-2);
  }
  .featured-text {
    padding: 36px 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .featured-date {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-soft);
    margin-bottom: 10px;
  }
  .featured-text h2 {
    font-size: 26px;
    font-weight: 500;
    margin: 0 0 12px;
    line-height: 1.25;
    color: var(--ink);
    font-family: var(--font-serif);
  }
  .featured-text p {
    font-size: 14.5px;
    color: var(--ink-soft);
    margin: 0 0 20px;
    line-height: 1.6;
  }
  .featured-image {
    background: var(--bg-3);
    width: 100%;
    height: 100%;
  }
  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .featured-image.placeholder {
    background: var(--bg-2);
  }
  .read-more {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-bottom: 32px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  /* Loyihalar / Artifaktlar / So'nggi postlar — uchta teng, ixcham ustun.
     Har biri to'liq sahifasiga taomil qiladi, shuning uchun bosh sahifa
     og'irlashmaydi: faqat 3 ta yengil matnli havola + "hammasini ko'r".
     Har bir ustun o'z rangi bilan (--hub-c) darhol ajralib turadi. */
  .hub {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 100px;
  }
  .hub-col {
    min-width: 0;
  }
  .hub-col[data-accent="projects"]  { --hub-c: var(--accent); }
  .hub-col[data-accent="artifacts"] { --hub-c: var(--hub-blue); }
  .hub-col[data-accent="posts"]     { --hub-c: var(--hub-green); }

  .hub-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 2px solid color-mix(in srgb, var(--hub-c) 45%, transparent);
  }
  .hub-head h2 {
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    color: var(--hub-c);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hub-head h2::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hub-c);
    flex-shrink: 0;
  }
  .hub-more {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .hub-more:hover {
    color: var(--hub-c);
  }
  .hub-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hub-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line-soft);
  }
  .hub-item:last-child {
    border-bottom: none;
  }
  .hub-item-title {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
    transition: color 0.2s;
  }
  .hub-item:hover .hub-item-title {
    color: var(--hub-c);
  }
  .hub-item-desc {
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty-state {
    grid-column: 1/-1;
    text-align: center;
    padding: 60px 20px;
    color: var(--ink-soft);
    font-style: italic;
    font-size: 15px;
  }

  @media (max-width: 860px) {
    .featured-post { grid-template-columns: 1fr; }
    .featured-image { min-height: 280px; order: -1; }
    .hub { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 640px) {
    .page-container { padding: 40px 0 0; }
    /* The fixed nav covers the top of the pinned hero; on a phone the hero
       nearly fills the screen, so centre it in the space below the nav or
       the heading slides under it. */
    .hero-pin { padding-top: var(--nav-height); }
    .hero { padding: 0 20px; }
    .hero-pin :global(footer) { padding: 16px 20px; }
    .hero h1 { font-size: 36px; }
    .hero-desc { font-size: 16px; }
    .featured-image { min-height: 220px; }
    .featured-text { padding: 24px 22px 26px; }
    .featured-text h2 { font-size: 23px; }
  }
  /* Small or short phones (iPhone SE, Android with browser chrome showing) */
  @media (max-width: 640px) and (max-height: 700px), (max-width: 380px) {
    .hero h1 { font-size: 30px; margin-bottom: 16px; }
    .hero-desc { font-size: 15px; line-height: 1.55; }
    .hero-cta { margin-top: 24px; gap: 10px; }
  }
</style>
