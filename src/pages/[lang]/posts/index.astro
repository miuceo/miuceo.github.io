---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);

const allPosts = await getCollection('posts');
const postsForLang = allPosts
  .filter((entry) => entry.slug.endsWith(`/${lang}`))
  .map((entry) => ({ slug: entry.slug.split('/')[0], data: entry.data }))
  .sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/posts/`])) as Record<Lang, string>;
---

<BaseLayout
  lang={lang}
  title={`${strings.postsPage.title} | ${strings.meta.siteTitle}`}
  description={strings.postsPage.desc}
  canonicalPath={`/${lang}/posts/`}
  hreflangPaths={langPaths}
>
  <Nav lang={lang} active="posts" langPaths={langPaths} />

  <main>
    <section class="page-header">
      <h1>{strings.postsPage.title}</h1>
      <p>{strings.postsPage.desc}</p>
    </section>

    {postsForLang.length === 0 ? (
      <div class="empty-state">{strings.home.noPosts}</div>
    ) : (
      <div class="archive">
        {postsForLang.map((p) => (
          <PostCard
            lang={lang}
            slug={p.slug}
            title={p.data.title}
            excerpt={p.data.excerpt ?? ''}
            createdAt={p.data.createdAt}
            coverImage={p.data.coverImage}
          />
        ))}
      </div>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .archive { max-width: 1040px; margin: 8px auto 0; }
</style>
