---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);

const allPosts = await getCollection('posts');
const postsForLang = allPosts
  .filter((entry) => entry.slug.endsWith(`/${lang}`))
  .map((entry) => ({ slug: entry.slug.split('/')[0], data: entry.data }))
  .sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/posts/`])) as Record<Lang, string>;
---

<BaseLayout
  lang={lang}
  title={`${strings.postsPage.title} — ${strings.masthead.name}`}
  description={strings.postsPage.desc}
  canonicalPath={`/${lang}/posts/`}
  hreflangPaths={langPaths}
>
  <Nav lang={lang} active="posts" langPaths={langPaths} />

  <main>
    <section class="page-header">
      <h1>{strings.postsPage.title}</h1>
      <p>{strings.postsPage.desc}</p>
    </section>

    {postsForLang.length === 0 ? (
      <div class="empty-state">{strings.home.noPosts}</div>
    ) : (
      <>
        <div class="posts-filter-bar">
          <div class="search-input-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="postSearch"
              placeholder={strings.post.searchPlaceholder}
              aria-label={strings.post.searchPlaceholder}
            />
          </div>
        </div>

        <div class="empty-state" id="noPostsFound" style="display: none;">
          {strings.projects.noResults}
        </div>

        <div class="archive" id="postsArchive">
          {postsForLang.map((p) => (
            <div class="post-item" data-search={`${p.data.title} ${p.data.excerpt ?? ''}`.toLowerCase()}>
              <PostCard
                lang={lang}
                slug={p.slug}
                title={p.data.title}
                excerpt={p.data.excerpt ?? ''}
                createdAt={p.data.createdAt}
                coverImage={p.data.coverImage}
              />
            </div>
          ))}
        </div>
      </>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script is:inline>
  (function () {
    var searchInput = document.getElementById('postSearch');
    var noPostsFound = document.getElementById('noPostsFound');
    var items = document.querySelectorAll('.post-item');

    if (!searchInput) return;

    searchInput.addEventListener('input', function () {
      var query = searchInput.value.trim().toLowerCase();
      var visibleCount = 0;

      items.forEach(function (item) {
        var text = item.getAttribute('data-search') || '';
        var matches = !query || text.indexOf(query) !== -1;
        if (matches) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noPostsFound) {
        noPostsFound.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  })();
</script>

<style>
  .posts-filter-bar {
    margin: var(--space-3) 0 var(--space-4);
  }
  .search-input-wrap {
    position: relative;
    max-width: 440px;
    width: 100%;
  }
  .search-input-wrap .search-icon {
    position: absolute;
    left: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
    color: var(--mid);
    pointer-events: none;
  }
  .search-input-wrap input {
    width: 100%;
    padding: 10px 14px 10px 38px;
    font-family: var(--font-heading);
    font-size: 14px;
    background: var(--surface);
    border: 1px solid var(--mid);
    border-radius: var(--radius-ui);
    color: var(--text);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .search-input-wrap input:focus {
    border-color: var(--accent-1);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent-1) 25%, transparent);
  }
  .search-input-wrap input::placeholder {
    color: var(--mid);
  }
  .archive {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-bottom: var(--space-6);
  }
  @media (max-width: 768px) {
    .archive {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
