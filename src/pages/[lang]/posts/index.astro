---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const strings = t(lang);

const allPosts = await getCollection('posts');
const postsForLang = allPosts
  .filter((entry) => entry.slug.endsWith(`/${lang}`))
  .map((entry) => ({ slug: entry.slug.split('/')[0], data: entry.data }))
  .sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

const langPaths = Object.fromEntries(LANGS.map((l) => [l, `/${l}/posts/`])) as Record<Lang, string>;
---

<BaseLayout
  lang={lang}
  title={`${strings.postsPage.title} | ${strings.meta.siteTitle}`}
  description={strings.postsPage.desc}
  canonicalPath={`/${lang}/posts/`}
  hreflangPaths={langPaths}
>
  <Nav lang={lang} active="posts" langPaths={langPaths} />

  <main class="page-container">
    <div class="header">
      <h1>{strings.postsPage.title}</h1>
      <p>{strings.postsPage.desc}</p>
    </div>

    {postsForLang.length === 0 ? (
      <div class="empty-state">{strings.home.noPosts}</div>
    ) : (
      <div class="masonry">
        {postsForLang.map((p) => (
          <div class="masonry-item">
            <PostCard
              lang={lang}
              slug={p.slug}
              title={p.data.title}
              excerpt={p.data.excerpt ?? ''}
              createdAt={p.data.createdAt}
              coverImage={p.data.coverImage}
            />
          </div>
        ))}
      </div>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .page-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 100px 40px 120px;
  }
  .header {
    max-width: 800px;
    margin: 0 auto 60px;
    text-align: center;
  }
  .header h1 {
    font-size: 36px;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .header p {
    font-size: 16px;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Pure-CSS masonry: cards flow down each column by source order, so
     taller cover images don't leave ragged gaps the way a plain grid would. */
  .masonry {
    column-count: 3;
    column-gap: 24px;
  }
  .masonry-item {
    break-inside: avoid;
    margin-bottom: 24px;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--ink-soft);
    font-style: italic;
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .masonry { column-count: 2; }
  }
  @media (max-width: 640px) {
    .page-container { padding: 60px 20px; }
    .header h1 { font-size: 28px; }
    .masonry { column-count: 1; }
  }
</style>
