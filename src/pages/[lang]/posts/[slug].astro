---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts.map((entry) => {
    const [slug, lang] = entry.slug.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'posts'>>>[number] };
const { Content, headings } = await render(entry);
const strings = t(lang);
const slug = entry.slug.split('/')[0];

const allPosts = await getCollection('posts');
const hreflangPaths = Object.fromEntries(
  LANGS.filter((l) => allPosts.some((e) => e.slug === `${slug}/${l}`)).map((l) => [l, `/${l}/posts/${slug}/`])
) as Partial<Record<Lang, string>>;

const langPaths = Object.fromEntries(LANGS.map((l) => [l, hreflangPaths[l] ?? `/${l}/`])) as Record<Lang, string>;

const dateFmt = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' });

// 2. Reading Time Calculation
const wordCount = (entry.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMins = Math.max(1, Math.round(wordCount / 200));

// 3. TOC Headings
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 5. Prev / Next Post Navigation & Share Bar
const postsForLang = allPosts
  .filter((e) => e.slug.endsWith(`/${lang}`))
  .map((e) => ({ slug: e.slug.split('/')[0], data: e.data }))
  .sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

const idx = postsForLang.findIndex((p) => p.slug === slug);
const nextPost = idx > 0 ? postsForLang[idx - 1] : null; // newer post
const prevPost = idx >= 0 && idx < postsForLang.length - 1 ? postsForLang[idx + 1] : null; // older post

const canonicalUrl = new URL(`/${lang}/posts/${slug}/`, Astro.site ?? 'https://muhammadjon.me').toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.excerpt,
  image: entry.data.coverImage,
  datePublished: entry.data.createdAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: 'Muhammadjon Ibrohimov' },
};
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} — ${strings.masthead.name}`}
  description={entry.data.excerpt ?? entry.data.title}
  canonicalPath={`/${lang}/posts/${slug}/`}
  hreflangPaths={hreflangPaths}
  ogImage={entry.data.coverImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="reading-progress-wrap" aria-hidden="true">
    <div class="reading-progress-bar" id="readingProgress"></div>
  </div>

  <Nav lang={lang} active="posts" langPaths={langPaths} />

  <article class="post">
    <header class="post-head">
      <a href={`/${lang}/posts/`} class="post-kicker">{strings.nav.posts}</a>
      <h1>{entry.data.title}</h1>
      {entry.data.excerpt && <p class="post-dek">{entry.data.excerpt}</p>}
      <div class="byline">
        <span class="byline-name">Muhammadjon Ibrohimov</span>
        <time datetime={entry.data.createdAt.toISOString()}>{dateFmt.format(entry.data.createdAt)}</time>
        <span class="reading-time">· {readingMins} {strings.post.readingTime}</span>
      </div>
    </header>

    {tocHeadings.length >= 2 && (
      <nav class="post-toc" aria-label={strings.post.tocTitle}>
        <div class="toc-header" role="button" tabindex="0" aria-expanded="true">
          <div class="toc-title">{strings.post.tocTitle}</div>
          <button type="button" class="toc-toggle-btn" aria-expanded="true" aria-label={strings.post.tocTitle}>
            <span class="toc-chevron" aria-hidden="true">▾</span>
          </button>
        </div>
        <ol class="toc-list">
          {tocHeadings.map((h) => (
            <li class={`toc-depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div
      class="post-body"
      data-prev={strings.gallery.prev}
      data-next={strings.gallery.next}
      data-copy={strings.post.copyCode}
      data-copied={strings.post.copiedCode}
    >
      <Content />
    </div>

    <div class="post-share-bar">
      <span class="share-label">{strings.post.shareTitle}</span>
      <div class="share-links">
        <a
          href={`https://t.me/share/url?url=${encodeURIComponent(canonicalUrl)}&text=${encodeURIComponent(entry.data.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn"
          aria-label={strings.post.shareTelegram}
        >
          <svg class="share-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
          <span>{strings.post.shareTelegram}</span>
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn"
          aria-label={strings.post.shareLinkedin}
        >
          <svg class="share-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
          <span>{strings.post.shareLinkedin}</span>
        </a>
        <button
          type="button"
          id="postCopyLinkBtn"
          class="share-btn"
          data-url={canonicalUrl}
          data-copied={strings.post.linkCopied}
        >
          <svg class="share-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span class="copy-link-text">{strings.post.copyLink}</span>
        </button>
      </div>
    </div>

    {(prevPost || nextPost) && (
      <nav class="post-nav-grid" aria-label="Post navigation">
        {prevPost ? (
          <a href={`/${lang}/posts/${prevPost.slug}/`} class="post-nav-card prev-card">
            <span class="nav-dir-label">{strings.post.prevPost}</span>
            <span class="nav-post-title">{prevPost.data.title}</span>
          </a>
        ) : (
          <div class="post-nav-empty" aria-hidden="true" />
        )}
        {nextPost ? (
          <a href={`/${lang}/posts/${nextPost.slug}/`} class="post-nav-card next-card">
            <span class="nav-dir-label">{strings.post.nextPost}</span>
            <span class="nav-post-title">{nextPost.data.title}</span>
          </a>
        ) : (
          <div class="post-nav-empty" aria-hidden="true" />
        )}
      </nav>
    )}
  </article>

  <Footer lang={lang} />
</BaseLayout>

<script>
  // 1. Reading Progress Bar
  const post = document.querySelector<HTMLElement>('.post');
  const progressBar = document.getElementById('readingProgress');
  if (post && progressBar) {
    const updateProgress = () => {
      const scrollY = window.scrollY || window.pageYOffset;
      const postTop = post.offsetTop;
      const postHeight = post.offsetHeight;
      const windowHeight = window.innerHeight;
      const scrollable = postHeight - windowHeight;
      if (scrollable <= 0) {
        progressBar.style.width = scrollY >= postTop ? '100%' : '0%';
        return;
      }
      const progress = Math.min(100, Math.max(0, ((scrollY - postTop) / scrollable) * 100));
      progressBar.style.width = `${progress}%`;
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  }

  // 3. TOC Collapsible Toggle
  const toc = document.querySelector<HTMLElement>('.post-toc');
  if (toc) {
    const toggleBtn = toc.querySelector<HTMLButtonElement>('.toc-toggle-btn');
    const header = toc.querySelector<HTMLElement>('.toc-header');
    const toggle = () => {
      const isCollapsed = toc.classList.toggle('is-collapsed');
      if (toggleBtn) {
        toggleBtn.setAttribute('aria-expanded', String(!isCollapsed));
      }
      header?.setAttribute('aria-expanded', String(!isCollapsed));
    };
    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });
    header?.addEventListener('click', toggle);
    header?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  }

  const body = document.querySelector<HTMLElement>('.post-body');

  // 4. One-Click Copy Code Button
  const copyText = body?.dataset.copy || 'Copy';
  const copiedText = body?.dataset.copied || 'Copied!';
  body?.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
    pre.style.position = 'relative';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy-btn';
    btn.textContent = copyText;
    btn.setAttribute('aria-label', copyText);
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      let text = '';
      if (code) {
        text = code.innerText;
      } else {
        const clone = pre.cloneNode(true) as HTMLElement;
        clone.querySelector('.code-copy-btn')?.remove();
        text = clone.innerText;
      }
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = copiedText;
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = copyText;
          btn.classList.remove('copied');
        }, 1800);
      } catch (err) {
        console.error('Failed to copy code', err);
      }
    });
    pre.appendChild(btn);
  });

  // 5. Share Bar Copy Link Button
  const copyLinkBtn = document.getElementById('postCopyLinkBtn') as HTMLButtonElement | null;
  if (copyLinkBtn) {
    const textSpan = copyLinkBtn.querySelector('.copy-link-text');
    const defaultText = textSpan?.textContent || copyLinkBtn.textContent || '';
    const linkCopiedText = copyLinkBtn.dataset.copied || 'Link copied!';
    copyLinkBtn.addEventListener('click', async () => {
      const url = copyLinkBtn.dataset.url || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (textSpan) {
          textSpan.textContent = linkCopiedText;
        } else {
          copyLinkBtn.textContent = linkCopiedText;
        }
        copyLinkBtn.classList.add('copied');
        setTimeout(() => {
          if (textSpan) {
            textSpan.textContent = defaultText;
          } else {
            copyLinkBtn.textContent = defaultText;
          }
          copyLinkBtn.classList.remove('copied');
        }, 1800);
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }

  // Layout decisions that need the image's real shape, which only the browser
  // knows (covers are remote URLs, so the build never sees their size).
  // Everything reads fine without this script: figures are full-width and
  // galleries are swipeable strips.
  // Tall or small pictures sit beside the text instead of stretching across it.
  // The lead figure is exempt — it opens the article at full width.
  body?.querySelectorAll<HTMLImageElement>('figure.post-figure img').forEach((img) => {
    const fig = img.closest('figure');
    if (!fig || fig === body.firstElementChild) return;
    const decide = () => {
      if (!img.naturalWidth) return;
      const tall = img.naturalHeight > img.naturalWidth * 1.15;
      const small = img.naturalWidth < 480;
      fig.classList.toggle('is-side', tall || small);
    };
    if (img.complete) decide();
    else img.addEventListener('load', decide, { once: true });
  });

  // Galleries: add prev/next and an "n / total" counter over the native
  // scroll-snap strip, so swiping and keyboard scrolling keep working.
  body?.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('.gallery-track');
    const slides = track ? (Array.from(track.children) as HTMLElement[]) : [];
    if (!track || slides.length < 2) return;

    const bar = document.createElement('div');
    bar.className = 'gallery-bar';
    const prev = document.createElement('button');
    const next = document.createElement('button');
    const count = document.createElement('span');
    prev.type = next.type = 'button';
    prev.className = 'gallery-btn';
    next.className = 'gallery-btn';
    prev.textContent = '←';
    next.textContent = '→';
    prev.setAttribute('aria-label', body.dataset.prev || 'Previous');
    next.setAttribute('aria-label', body.dataset.next || 'Next');
    count.className = 'gallery-count';
    bar.append(prev, count, next);
    gallery.append(bar);

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const update = () => {
      const i = current();
      count.textContent = `${i + 1} / ${slides.length}`;
      prev.disabled = i <= 0;
      next.disabled = i >= slides.length - 1;
    };
    const go = (d: number) => track.scrollTo({ left: (current() + d) * track.clientWidth, behavior: 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
  });
</script>

<style>
  /* 1. Reading Progress Bar */
  .reading-progress-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: transparent;
    pointer-events: none;
  }
  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--accent-1);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent-1) 70%, transparent);
    transition: width 0.1s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-progress-bar {
      transition: none;
    }
  }

  .post {
    padding: var(--space-6) 0 var(--space-5);
    max-width: 680px;
    margin: 0 auto;
  }
  .post-head {
    margin-bottom: var(--space-5);
    text-align: left;
  }
  .post-kicker {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 11px;
    line-height: 1;
    background: var(--accent-1);
    color: var(--on-accent-1);
    text-decoration: none;
    margin-bottom: var(--space-3);
  }
  .post h1 {
    font-family: var(--font-heading);
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .post-dek {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1.6;
    color: var(--text);
    margin: 0 0 var(--space-4);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--mid);
    border-bottom: 1px solid var(--mid);
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }
  .byline-name {
    font-weight: 600;
    color: var(--text);
  }

  /* 2. Reading Time */
  .reading-time {
    color: var(--text);
    opacity: 0.85;
    font-weight: 500;
  }

  /* 3. Table of Contents */
  .post-toc {
    background: var(--surface);
    border: 1px solid var(--mid);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    margin: 0 0 var(--space-5);
    transition: border-color 0.2s ease;
  }
  .post-toc:hover {
    border-color: var(--accent-1);
  }
  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
  }
  .toc-header:focus-visible {
    outline: 2px solid var(--accent-1);
    outline-offset: 2px;
    border-radius: var(--radius-ui);
  }
  .toc-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .toc-toggle-btn {
    background: transparent;
    border: none;
    color: var(--text);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-ui);
    transition: transform 0.2s ease, background 0.15s ease;
    min-width: 32px;
    min-height: 32px;
  }
  .toc-toggle-btn:hover {
    background: var(--bg);
  }
  .post-toc.is-collapsed .toc-chevron {
    transform: rotate(-90deg);
  }
  .post-toc.is-collapsed .toc-list {
    display: none;
  }
  .toc-chevron {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid color-mix(in srgb, var(--mid) 50%, transparent);
    padding-top: var(--space-3);
  }
  .toc-list li {
    margin: 0;
    line-height: 1.4;
  }
  .toc-list li a {
    color: var(--text);
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease, padding-left 0.15s ease;
  }
  .toc-list li a:hover {
    color: var(--accent-1);
    text-decoration: underline;
  }
  .toc-list .toc-depth-3 {
    padding-left: var(--space-3);
    font-size: 13px;
    opacity: 0.9;
  }

  .post-body {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: var(--text);
  }
  .post-body :global(p) {
    margin: 0 0 var(--space-4);
  }

  /* Figures: full column width by default, caption from the alt text. */
  .post-body :global(figure) {
    margin: var(--space-4) 0 var(--space-5);
  }
  .post-body :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface);
    border-radius: var(--radius-card);
  }
  .post-body :global(figcaption) {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
    padding-top: var(--space-2);
    margin: 0;
  }

  /* The lead figure opens the article: wider than the text, never taller than the screen. */
  .post-body > :global(figure.post-figure:first-child) {
    margin: 0 -120px var(--space-5);
  }
  .post-body > :global(figure.post-figure:first-child img) {
    max-height: 78vh;
    object-fit: contain;
    border-radius: var(--radius-card);
  }
  .post-body > :global(figure.post-figure:first-child figcaption) {
    padding-left: 120px;
    padding-right: 120px;
  }

  /* Tall or small pictures sit beside the text. */
  .post-body :global(figure.is-side) {
    float: right;
    width: 44%;
    margin: 6px 0 var(--space-3) var(--space-4);
  }
  .post-body :global(figure.is-side img) {
    border-radius: var(--radius-card);
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4),
  .post-body :global(blockquote),
  .post-body :global(.gallery),
  .post-body :global(hr) {
    clear: both;
  }
  .post-body::after {
    content: '';
    display: block;
    clear: both;
  }

  /* Headings scroll margin for smooth TOC linking */
  .post-body :global(h2),
  .post-body :global(h3) {
    scroll-margin-top: 24px;
  }

  /* Gallery: a native scroll-snap strip (swipeable, works with JS off). */
  .post-body :global(.gallery) {
    margin: var(--space-4) 0 var(--space-5);
  }
  .post-body :global(.gallery-track) {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    background: var(--surface);
    border-radius: var(--radius-card);
  }
  .post-body :global(.gallery-track::-webkit-scrollbar) {
    display: none;
  }
  .post-body :global(.gallery-slide) {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  .post-body :global(.gallery-slide img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }
  .post-body :global(.gallery-slide figcaption) {
    margin-top: auto;
    background: var(--bg);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }

  .post-body :global(.gallery-bar) {
    display: flex;
    align-items: center;
