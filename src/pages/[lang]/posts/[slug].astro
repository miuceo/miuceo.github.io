---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts.map((entry) => {
    const [slug, lang] = entry.slug.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'posts'>>>[number] };
const { Content } = await render(entry);
const strings = t(lang);
const slug = entry.slug.split('/')[0];

const allPosts = await getCollection('posts');
const hreflangPaths = Object.fromEntries(
  LANGS.filter((l) => allPosts.some((e) => e.slug === `${slug}/${l}`)).map((l) => [l, `/${l}/posts/${slug}/`])
) as Partial<Record<Lang, string>>;

const langPaths = Object.fromEntries(LANGS.map((l) => [l, hreflangPaths[l] ?? `/${l}/`])) as Record<Lang, string>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.excerpt,
  image: entry.data.coverImage,
  datePublished: entry.data.createdAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  author: { '@type': 'Person', name: 'Muhammadjon Ibrohimov' },
};
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} — miuceo`}
  description={entry.data.excerpt ?? entry.data.title}
  canonicalPath={`/${lang}/posts/${slug}/`}
  hreflangPaths={hreflangPaths}
  ogImage={entry.data.coverImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <Nav lang={lang} active="posts" langPaths={langPaths} />

  <article class="post">
    <h1>{entry.data.title}</h1>
    <div class="post-body">
      <Content />
    </div>
  </article>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .post{ padding:60px 0 100px; max-width:760px; margin:0 auto; }
  .post h1{ font-size:36px; font-weight:800; line-height:1.2; margin:0 0 32px; }
  .post-body{ font-size:16px; line-height:1.8; color:var(--ink); }
  .post-body :global(p){ margin:0 0 22px; }
  .post-body :global(img){ max-width:100%; border-radius:8px; margin:8px 0 28px; display:block; }
  .post-body :global(a){ color:var(--neon-green); text-decoration:underline; }
  .post-body :global(h2){ font-size:24px; margin:40px 0 16px; }
  .post-body :global(h3){ font-size:19px; margin:32px 0 14px; }
  .post-body :global(code){ background:var(--bg-2); border:1px solid var(--line); border-radius:4px; padding:2px 6px; font-size:0.9em; }
  .post-body :global(pre){ background:var(--bg-2); border:1px solid var(--line); border-radius:8px; padding:18px; overflow-x:auto; }
  @media (max-width:640px){
    .post{ padding:32px 0 60px; }
    .post h1{ font-size:26px; }
  }
</style>
