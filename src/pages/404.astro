---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LANG, LANGS, t } from '../lib/i18n';
import { SITE_NAME } from '../lib/site';

const strings = t(DEFAULT_LANG);

const translations = Object.fromEntries(
  LANGS.map((l) => [l, { title: t(l).notFound.title, desc: t(l).notFound.desc, back: t(l).notFound.backHome }])
);
---

<BaseLayout
  lang={DEFAULT_LANG}
  title={`${strings.notFound.title} — ${SITE_NAME}`}
  description={strings.notFound.desc}
  canonicalPath="/404/"
  hreflangPaths={{}}
  noindex={true}
>
  <script is:inline>
    (function () {
      var p = location.pathname;
      if (p === '/ai-news-agent' || p.indexOf('/ai-news-agent/') === 0) {
        location.replace('/neuron-uz' + p.slice('/ai-news-agent'.length) + location.search + location.hash);
      }
    })();
  </script>

  <div class="not-found-wrap">
    <div class="card">
      <div class="mark">{SITE_NAME}</div>
      <div class="code">404</div>
      <h1 id="nfTitle">{strings.notFound.title}</h1>
      <p id="nfDesc">{strings.notFound.desc}</p>
      <a href={`/${DEFAULT_LANG}/`} id="nfBack" class="btn btn-primary">{strings.notFound.backHome}</a>
    </div>
  </div>

  <script is:inline define:vars={{ translations, DEFAULT_LANG }}>
    (function () {
      var supported = Object.keys(translations);
      var fromPath = (location.pathname.split('/')[1] || '').toLowerCase();
      var lang =
        supported.indexOf(fromPath) !== -1
          ? fromPath
          : (function(){ try { return localStorage.getItem('miuceo_lang'); } catch(e){ return null; } })() || DEFAULT_LANG;
      if (supported.indexOf(lang) === -1) lang = DEFAULT_LANG;

      var s = translations[lang];
      document.documentElement.lang = lang;
      document.getElementById('nfTitle').textContent = s.title;
      document.getElementById('nfDesc').textContent = s.desc;
      var back = document.getElementById('nfBack');
      back.textContent = s.back;
      back.href = '/' + lang + '/';
    })();
  </script>
</BaseLayout>

<style>
  .not-found-wrap {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) 0;
  }
  .card {
    text-align: center;
    padding: var(--space-5);
    max-width: 520px;
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--mid);
    border-radius: var(--radius-card);
    box-sizing: border-box;
  }
  .mark {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-1-text);
    margin-bottom: var(--space-4);
  }
  .code {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 80px;
    line-height: 1;
    color: var(--accent-1);
    margin-bottom: var(--space-2);
  }
  h1 {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    margin: 0 0 var(--space-2);
  }
  p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }
  .btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
