---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LANG, LANGS, t } from '../lib/i18n';

// GitHub Pages serves this one file for every unmatched path, so it cannot be
// pre-rendered per language. It ships in the default language and swaps to the
// right one before paint, using the language prefix of the URL that 404'd
// (/en/nope -> English) and falling back to the reader's stored preference.
const strings = t(DEFAULT_LANG);

const translations = Object.fromEntries(
  LANGS.map((l) => [l, { title: t(l).notFound.title, desc: t(l).notFound.desc, back: t(l).notFound.backHome }])
);
---

<BaseLayout
  lang={DEFAULT_LANG}
  title={`${strings.notFound.title} — miuceo`}
  description={strings.notFound.desc}
  canonicalPath="/404/"
  hreflangPaths={{}}
  noindex={true}
>
  <div class="card">
    <div class="code">404</div>
    <h1 id="nfTitle">{strings.notFound.title}</h1>
    <p id="nfDesc">{strings.notFound.desc}</p>
    <a href={`/${DEFAULT_LANG}/`} id="nfBack" class="btn">{strings.notFound.backHome}</a>
  </div>

  <script is:inline define:vars={{ translations, DEFAULT_LANG }}>
    (function () {
      var supported = Object.keys(translations);
      var fromPath = (location.pathname.split('/')[1] || '').toLowerCase();
      var lang =
        supported.indexOf(fromPath) !== -1
          ? fromPath
          : localStorage.getItem('miuceo_lang') || DEFAULT_LANG;
      if (supported.indexOf(lang) === -1) lang = DEFAULT_LANG;

      var s = translations[lang];
      document.documentElement.lang = lang;
      document.getElementById('nfTitle').textContent = s.title;
      document.getElementById('nfDesc').textContent = s.desc;
      var back = document.getElementById('nfBack');
      back.textContent = s.back;
      back.href = '/' + lang + '/';
    })();
  </script>
</BaseLayout>

<style>
  :global(body){ min-height:100vh; display:flex; align-items:center; justify-content:center; }
  .card{ text-align:center; padding:40px; max-width:440px; }
  .code{ font-size:14px; color:var(--neon-green); text-shadow:var(--glow-sm) var(--neon-green); letter-spacing:0.08em; margin-bottom:14px; }
  h1{ font-size:30px; font-weight:700; margin:0 0 14px; }
  p{ font-size:15px; color:var(--ink-soft); line-height:1.6; margin:0 0 32px; }
</style>
