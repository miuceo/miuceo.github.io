---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
import { modelBadge } from '../lib/artifacts';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description?: string;
  model: string;
  date: Date;
  tags: string[];
  requiresClaude: boolean;
}

const { lang, slug, title, description, model, date, tags, requiresClaude } = Astro.props;
const strings = t(lang);
const badge = modelBadge(model);

const dateFmt = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' });
---

<a href={`/${lang}/artifacts/${slug}/`} class="card">
  <span class="kicker red">
    <span aria-hidden="true">{badge.emoji}</span> {badge.label}
  </span>
  <h3 class="card-title"><span class="hl">{title}</span></h3>
  {description && <p class="card-desc">{description}</p>}
  <div class="card-bottom">
    <time class="card-date" datetime={date.toISOString()}>{dateFmt.format(date)}</time>
    {tags.length > 0 && <span class="tags">{tags.slice(0, 4).join(' · ')}</span>}
    {requiresClaude && <span class="claude-only">{strings.artifacts.requiresClaudeBadge}</span>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 12px 0 24px;
    border-top: 2px solid var(--rule);
    color: var(--ink);
  }
  .card-title { font-size: 24px; line-height: 1.15; margin: 0; }
  .card-desc {
    font-family: var(--font-body); font-size: 16px; line-height: 1.5;
    color: var(--ink-soft); margin: 0; flex-grow: 1;
  }
  .card-bottom {
    margin-top: auto; padding-top: 10px; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; gap: 4px 14px;
    font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft);
  }
  .claude-only { color: var(--accent); }
</style>
