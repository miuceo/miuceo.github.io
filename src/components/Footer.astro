---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const strings = t(lang);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand-col">
      <a href={`/${lang}/`} class="footer-mark">{strings.masthead.name}</a>
      <p class="footer-copyright">{strings.footer.copyright}</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href={`/${lang}/rss.xml`}>RSS</a>
      <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener">Telegram</a>
      <a href="https://github.com/miuceo" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    margin-bottom: var(--space-5);
    background: var(--band);
    color: var(--band-text);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-5);
    transition: background-color .25s ease, color .25s ease;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-mark {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    color: var(--band-text);
    text-decoration: none;
    transition: opacity .2s, text-shadow .2s ease;
  }
  .footer-mark:hover {
    opacity: 1;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 55%, transparent);
  }
  .footer-copyright {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--band-text);
    margin: 0;
    opacity: 0.85;
  }
  .footer-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 500;
    color: var(--band-text);
    text-decoration: none;
    opacity: 0.85;
    padding: 4px 0;
    transition: opacity .2s, text-shadow .2s ease;
  }
  .footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 55%, transparent);
  }
  @media (max-width: 640px) {
    .site-footer {
      padding: var(--space-4) var(--space-3);
      margin-top: var(--space-5);
      margin-bottom: var(--space-4);
    }
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .footer-links {
      gap: var(--space-3);
    }
  }
</style>
