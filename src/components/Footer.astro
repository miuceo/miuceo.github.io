---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const strings = t(lang);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand-col">
      <a href={`/${lang}/`} class="footer-mark">
        <svg class="footer-logo" width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="0.5" y="0.5" width="31" height="31" rx="7.5" class="f-logo-bg" />
          <path d="M6.5 22.5V9.5h2.6l4.15 6.4 4.15-6.4H20v13h-2.7v-8.3l-3.45 5.2h-1.2L9.2 14.2v8.3H6.5Z" class="f-logo-m" />
          <circle cx="24" cy="10.8" r="1.75" class="f-logo-dot" />
          <rect x="22.65" y="14.2" width="2.7" height="8.3" rx="1.35" class="f-logo-stem" />
        </svg>
        <span>{strings.masthead.name}</span>
      </a>
      <p class="footer-copyright">{strings.footer.copyright}</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href={`/${lang}/rss.xml`}>RSS</a>
      <a href="https://t.me/muhammadibrohimov_ceo" target="_blank" rel="noopener">Telegram</a>
      <a href="https://github.com/miuceo" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    margin-bottom: var(--space-5);
    background: var(--band);
    color: var(--band-text);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-5);
    transition: background-color .25s ease, color .25s ease;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-mark {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    color: var(--band-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    transition: opacity .2s, text-shadow .2s ease;
  }
  .footer-logo {
    flex-shrink: 0;
  }
  .f-logo-bg {
    fill: color-mix(in srgb, var(--band-text) 10%, var(--band));
    stroke: color-mix(in srgb, var(--band-text) 22%, transparent);
    stroke-width: 1;
  }
  .f-logo-m {
    fill: var(--accent-1);
  }
  .f-logo-dot {
    fill: var(--accent-2);
  }
  .f-logo-stem {
    fill: var(--accent-3);
  }
  .footer-mark:hover {
    opacity: 1;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 55%, transparent);
  }
  .footer-copyright {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--band-text);
    margin: 0;
    opacity: 0.85;
  }
  .footer-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 500;
    color: var(--band-text);
    text-decoration: none;
    opacity: 0.85;
    padding: 4px 0;
    transition: opacity .2s, text-shadow .2s ease;
  }
  .footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 55%, transparent);
  }
  @media (max-width: 640px) {
    .site-footer {
      padding: var(--space-4) var(--space-3);
      margin-top: var(--space-5);
      margin-bottom: var(--space-4);
    }
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .footer-links {
      gap: var(--space-3);
    }
  }
</style>
