---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  problem?: string;
  solution?: string;
  result?: string;
  tags: string[];
  status: 'active' | 'archived';
  url: string;
  external: boolean;
  stars?: number | null;
}

const { lang, title, description, problem, solution, result, tags, status, url, external, stars } = Astro.props;
const strings = t(lang);
const linkLabel = external ? strings.projects.viewGithub : strings.projects.openTool;
const hasStory = problem && solution && result;
---

<div class="project-card">
  <span class={`status-badge status-${status}`}>
    {status === 'active' ? strings.projects.statusActive : strings.projects.statusArchived}
  </span>
  <h2>{title}</h2>

  {hasStory ? (
    <dl class="story">
      <div class="story-row">
        <dt>{strings.projects.problem}</dt>
        <dd>{problem}</dd>
      </div>
      <div class="story-row">
        <dt>{strings.projects.solution}</dt>
        <dd>{solution}</dd>
      </div>
      <div class="story-row">
        <dt>{strings.projects.result}</dt>
        <dd>{result}</dd>
      </div>
    </dl>
  ) : (
    <p class="desc">{description}</p>
  )}

  {tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}

  <div class="card-bottom">
    {external
      ? <a href={url} target="_blank" rel="noopener" class="project-link">{linkLabel}</a>
      : <a href={url} class="project-link">{linkLabel}</a>}
    {typeof stars === 'number' && (
      <span class="stars" title={strings.projects.starsLabel}>
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
        {stars}
      </span>
    )}
  </div>
</div>

<style>
  /* A newspaper column, not a card: heavy top rule, no box. */
  .project-card{ border-top:2px solid var(--rule); padding:12px 0 28px; display:flex; flex-direction:column; }

  .status-badge{ font-family:var(--font-sans); font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:8px; }
  .status-active{ color:var(--accent); }
  .status-archived{ color:var(--ink-soft); }
  .project-card h2{ font-size:28px; line-height:1.15; margin:0 0 14px; }

  .desc{ font-family:var(--font-body); font-size:17px; color:var(--ink-soft); line-height:1.55; flex:1; margin:0 0 18px; }

  .story{ margin:0 0 18px; flex:1; }
  .story-row{ display:grid; grid-template-columns:92px minmax(0,1fr); gap:14px; padding:10px 0; border-top:1px solid var(--line); }
  .story dt{ font-family:var(--font-sans); font-size:10.5px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent); padding-top:4px; }
  .story dd{ font-family:var(--font-body); font-size:16px; color:var(--ink); line-height:1.5; margin:0; }

  .tags{ font-family:var(--font-sans); font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-soft); margin:0 0 16px; }

  .card-bottom{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:auto; padding-top:12px; border-top:1px solid var(--line); }
  .project-link{ font-family:var(--font-sans); font-size:12px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink); }
  .project-link:hover{ color:var(--accent); }
  .stars{ display:inline-flex; align-items:center; gap:5px; font-family:var(--font-sans); font-size:12px; color:var(--ink-soft); }

  @media (max-width:640px){ .project-card h2{ font-size:24px; } .story-row{ grid-template-columns:1fr; gap:4px; } .story dt{ padding-top:0; } }
</style>
