---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  excerpt: string;
  createdAt: Date;
  coverImage?: string;
}

const { lang, slug, title, excerpt, createdAt, coverImage } = Astro.props;

const dateFmt = new Intl.DateTimeFormat(lang, {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<!-- One row of the archive: date gutter, headline + dek, optional thumbnail.
     No image means no empty box — the row is simply text. -->
<a href={`/${lang}/posts/${slug}/`} class:list={['row', { 'has-image': coverImage }]}>
  <time class="row-date" datetime={createdAt.toISOString()}>{dateFmt.format(createdAt)}</time>
  <div class="row-text">
    <h2 class="row-title"><span class="hl">{title}</span></h2>
    {excerpt && <p class="row-excerpt">{excerpt}</p>}
  </div>
  {coverImage && (
    <figure class="row-image"><img src={coverImage} alt="" loading="lazy" /></figure>
  )}
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 28px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .row.has-image { grid-template-columns: 150px minmax(0, 1fr) 220px; }
  .row-date {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-top: 7px;
  }
  .row-title { font-size: 28px; line-height: 1.15; margin: 0 0 10px; }
  .row-excerpt {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
    max-width: 640px;
  }
  .row-image { margin: 0; overflow: hidden; background: var(--bg-3); align-self: start; }
  .row-image img {
    display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover;
    transition: transform .8s ease;
  }
  .row:hover .row-image img { transform: scale(1.02); }

  @media (max-width: 760px) {
    .row, .row.has-image { grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 22px 0; }
    .row-date { padding-top: 0; order: 1; }
    .row-text { order: 2; }
    .row-image { order: 0; margin-bottom: 8px; }
    .row-title { font-size: 23px; }
    .row-excerpt { font-size: 16px; }
  }
</style>
