---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  excerpt: string;
  createdAt: Date;
  coverImage?: string;
}

const { lang, slug, title, excerpt, createdAt, coverImage } = Astro.props;
const strings = t(lang);

const dateFmt = new Intl.DateTimeFormat(lang, {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<a href={`/${lang}/posts/${slug}/`} class="card">
  {coverImage && (
    <div class="card-image">
      <img src={coverImage} alt={title} loading="lazy" />
    </div>
  )}
  <div class="card-body">
    <div class="card-header">
      <h3 class="card-title">{title}</h3>
      <div class="card-date">{dateFmt.format(createdAt)}</div>
    </div>
    <p class="card-excerpt">{excerpt}</p>
    <div class="card-footer">
      <span class="read-more">{strings.home.continueReading}</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    height: 100%;
  }
  .card:hover {
    border-color: var(--ink-soft);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transform: translateY(-2px);
  }
  .card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-3);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 32px;
  }
  .card-header {
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
  }
  .card-title {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--ink);
    line-height: 1.35;
  }
  .card-date {
    font-size: 13px;
    color: var(--ink-soft);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .card-excerpt {
    font-size: 15px;
    color: var(--ink-soft);
    margin: 0 0 24px;
    line-height: 1.6;
    flex-grow: 1;
  }
  .card-footer {
    margin-top: auto;
  }
  .read-more {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
  }
</style>
