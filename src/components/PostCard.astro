---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  excerpt: string;
  createdAt: Date;
  coverImage?: string;
  showKind?: boolean;
}

const { lang, slug, title, excerpt, createdAt, coverImage, showKind = false } = Astro.props;
const strings = t(lang);

const dateFmt = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/${lang}/posts/${slug}/`} class:list={['post-card', { 'has-image': !!coverImage }]}>
  {coverImage && (
    <figure class="card-image">
      <img src={coverImage} alt="" loading="lazy" />
    </figure>
  )}
  <div class="card-body">
    <div class="card-meta">
      {showKind && <span class="kind-pill">{strings.home.kickerPost}</span>}
      <time class="card-date" datetime={createdAt.toISOString()}>{dateFmt.format(createdAt)}</time>
    </div>
    <h2 class="card-title"><span class="hl">{title}</span></h2>
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--mid);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
    box-sizing: border-box;
  }
  .post-card:hover {
    border-color: var(--accent-1);
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent-1) 25%, transparent);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }
  .card-image {
    margin: 0 0 var(--space-3);
    border-radius: var(--radius-ui);
    overflow: hidden;
    background: var(--surface);
  }
  .card-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }
  .kind-pill {
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 11px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    background: var(--accent-1);
    color: var(--on-accent-1);
  }
  .card-date {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    margin: 0 0 var(--space-2);
  }
  .card-excerpt {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
    flex-grow: 0;
  }
</style>
