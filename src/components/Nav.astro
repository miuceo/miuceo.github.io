---
import type { Lang } from '../lib/i18n';
import { LANGS, t } from '../lib/i18n';
import CommandPalette from './CommandPalette.astro';

interface Props {
  lang: Lang;
  active: 'posts' | 'projects' | 'about' | 'contact' | 'artifacts' | 'none';
  /** slug of the equivalent page in each language, e.g. { uz: '/uz/', en: '/en/', ru: '/ru/' } */
  langPaths: Record<Lang, string>;
  /** Front page flag kept for interface compatibility */
  front?: boolean;
}

const { lang, active, langPaths } = Astro.props;
const strings = t(lang);

const sections = [
  { key: 'posts', href: `/${lang}/posts/`, label: strings.nav.posts },
  { key: 'projects', href: `/${lang}/projects/`, label: strings.nav.projects },
  { key: 'artifacts', href: `/${lang}/artifacts/`, label: strings.nav.artifacts, isNew: true },
  { key: 'about', href: `/${lang}/about/`, label: strings.nav.about },
  { key: 'contact', href: `/${lang}/contact/`, label: strings.nav.contact },
] as const;
---

<header class="site-header">
  <div class="nav-bar">
    <a href={`/${lang}/`} class="nav-brand">
      <svg class="brand-logo" width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect x="0.5" y="0.5" width="31" height="31" rx="7.5" class="logo-bg" />
        <path d="M6.5 22.5V9.5h2.6l4.15 6.4 4.15-6.4H20v13h-2.7v-8.3l-3.45 5.2h-1.2L9.2 14.2v8.3H6.5Z" class="logo-m" />
        <circle cx="24" cy="10.8" r="1.75" class="logo-dot" />
        <rect x="22.65" y="14.2" width="2.7" height="8.3" rx="1.35" class="logo-stem" />
      </svg>
      <span>{strings.masthead.name}</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      {sections.map((s) => (
        <a
          href={s.href}
          class:list={['nav-link', { active: active === s.key }]}
          aria-current={active === s.key ? 'page' : undefined}
        >
          <span>{s.label}</span>
          {'isNew' in s && <span class="tag-new">{strings.nav.new}</span>}
        </a>
      ))}
      <a href="/neuron-uz/" class="nav-pill-coral">Neuron UZ</a>
    </nav>

    <div class="nav-actions">
      <button type="button" class="nav-search-btn" id="cmdkTrigger" data-open-cmdk aria-label={strings.search.buttonLabel} title={`${strings.search.buttonLabel} (Ctrl+K)`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <div class="lang-switch" role="group" aria-label="Language selection">
        {LANGS.map((l) => (
          <a
            href={langPaths[l]}
            class:list={['lang-link', { active: l === lang }]}
            aria-current={l === lang ? 'page' : undefined}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle Theme">
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
      <a href="/admin.html" class="nav-admin" title={strings.nav.admin} aria-label={strings.nav.admin}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      </a>
    </div>
  </div>
</header>

<CommandPalette lang={lang} />

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--mid);
    transition: background-color .25s ease, border-color .25s ease;
  }
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 1.6vw, 24px);
    min-height: 60px;
    padding: 8px 0;
    width: 100%;
    max-width: 100%;
  }
  .nav-brand {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.01em;
    padding: var(--space-1) 0;
    flex-shrink: 0;
    margin-right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .brand-logo {
    flex-shrink: 0;
    border-radius: 7px;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .logo-bg {
    fill: var(--surface);
    stroke: var(--mid);
    stroke-width: 1;
  }
  .logo-m {
    fill: var(--accent-1);
  }
  .logo-dot {
    fill: var(--accent-2);
  }
  .logo-stem {
    fill: var(--accent-3);
  }
  .nav-brand:hover {
    color: var(--accent-1-text);
  }
  .nav-brand:hover .brand-logo {
    transform: translateY(-1px);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 40%, transparent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.1vw, 18px);
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    white-space: nowrap;
    transition: color .2s, border-color .2s, text-shadow .2s ease;
  }
  .nav-link:hover {
    color: var(--accent-1-text);
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 55%, transparent);
  }
  .nav-link.active {
    color: var(--accent-1-text);
    border-bottom-color: var(--accent-1-text);
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-1) 55%, transparent);
  }

  @keyframes glow-pulse {
    0%, 100% {
      box-shadow: 0 0 8px color-mix(in srgb, var(--accent-3) 75%, transparent), 0 0 16px color-mix(in srgb, var(--accent-3) 45%, transparent);
    }
    50% {
      box-shadow: 0 0 12px color-mix(in srgb, var(--accent-3) 90%, transparent), 0 0 22px color-mix(in srgb, var(--accent-3) 60%, transparent);
    }
  }

  .tag-new {
    background: var(--accent-3);
    color: var(--on-accent-3);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    line-height: 1.2;
    display: inline-block;
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent-3) 75%, transparent), 0 0 16px color-mix(in srgb, var(--accent-3) 45%, transparent);
    animation: glow-pulse 2.5s ease-in-out infinite;
  }

  .nav-pill-coral {
    background: var(--accent-2);
    color: var(--on-accent-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    padding: 5px 12px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent-2) 75%, transparent), 0 0 18px color-mix(in srgb, var(--accent-2) 45%, transparent);
    transition: opacity .2s, box-shadow .2s ease;
  }
  .nav-pill-coral:hover {
    opacity: 1;
    box-shadow: 0 0 12px var(--accent-2), 0 0 24px color-mix(in srgb, var(--accent-2) 70%, transparent);
    text-shadow: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .nav-search-btn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    color: var(--text);
    transition: background-color .2s ease, border-color .2s ease, color .2s ease;
  }
  .nav-search-btn:hover {
    background: var(--surface);
    color: var(--accent-1-text);
    border-color: var(--mid);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .lang-link {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    padding: 6px 4px;
    min-width: 28px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    opacity: 0.65;
    transition: opacity .2s, color .2s;
  }
  .lang-link:hover {
    opacity: 1;
    color: var(--accent-1-text);
  }
  .lang-link.active {
    opacity: 1;
    color: var(--accent-1-text);
  }

  .theme-toggle {
    background: transparent;
    border: none;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text);
    padding: 0;
    transition: background .2s, color .2s;
  }
  .theme-toggle:hover {
    background: var(--surface);
    color: var(--text);
  }

  .nav-admin {
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    border-radius: 50%;
    text-decoration: none;
    transition: background .2s, color .2s;
  }
  .nav-admin:hover {
    background: var(--surface);
    color: var(--accent-1-text);
  }

  @media (max-width: 1200px) {
    .nav-brand {
      font-size: 17px;
      margin-right: 8px;
    }
    .nav-link {
      font-size: 13.5px;
    }
    .nav-pill-coral {
      font-size: 12px;
      padding: 4px 10px;
    }
  }

  @media (max-width: 1100px) {
    .nav-bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      gap: 0 var(--space-2);
      padding: var(--space-1) 0;
      width: 100%;
      max-width: 100%;
    }
    .nav-brand {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      font-size: 16px;
      margin-right: 0;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nav-actions {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
    .nav-links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      gap: var(--space-3);
      padding: 8px 4px;
      border-top: 1px solid var(--surface);
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-new {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .nav-brand {
      font-size: 15px;
    }
    .lang-link {
      min-width: 28px;
      min-height: 40px;
      padding: 4px;
      font-size: 12px;
    }
    .theme-toggle,
    .nav-admin,
    .nav-search-btn {
      width: 38px;
      height: 38px;
      min-width: 38px;
      min-height: 38px;
    }
  }
</style>
