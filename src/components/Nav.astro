---
import type { Lang } from '../lib/i18n';
import { LANGS, t } from '../lib/i18n';

interface Props {
  lang: Lang;
  active: 'posts' | 'projects' | 'about' | 'contact' | 'artifacts' | 'none';
  /** slug of the equivalent page in each language, e.g. { uz: '/uz/', en: '/en/', ru: '/ru/' } */
  langPaths: Record<Lang, string>;
  /** Front page gets the full-size masthead; inner pages a smaller one. */
  front?: boolean;
}

const { lang, active, langPaths, front = false } = Astro.props;
const strings = t(lang);

const sections = [
  { key: 'posts', href: `/${lang}/posts/`, label: strings.nav.posts },
  { key: 'projects', href: `/${lang}/projects/`, label: strings.nav.projects },
  { key: 'artifacts', href: `/${lang}/artifacts/`, label: strings.nav.artifacts, isNew: true },
  { key: 'about', href: `/${lang}/about/`, label: strings.nav.about },
  { key: 'contact', href: `/${lang}/contact/`, label: strings.nav.contact },
] as const;
---

<header class:list={['masthead-block', { front }]}>
  <div class="dateline">
    <span class="dateline-left">
      <!-- Filled in the browser: the site is static, so a build-time date
           would be stale by tomorrow. Empty (not wrong) with JS off. -->
      <span class="today" id="mhToday" data-lang={lang}></span>
      <span class="dateline-tagline">{strings.masthead.tagline}</span>
    </span>
    <div class="nav-actions">
      <div class="lang-switch">
        {LANGS.map((l) => (
          <a href={langPaths[l]} class={l === lang ? 'active' : ''}>{l.toUpperCase()}</a>
        ))}
      </div>
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle Theme">
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
      <a href="/login.html" class="nav-admin" title={strings.nav.admin} aria-label={strings.nav.admin}>
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      </a>
    </div>
  </div>

  <a href={`/${lang}/`} class="masthead">{strings.masthead.name}</a>
</header>

<!-- Sibling of the header (not inside it) so position:sticky can stick for
     the whole page rather than only within the header's own box. -->
<nav class="sections" aria-label="Sections">
  <div class="sections-inner">
    {sections.map((s) => (
      <a href={s.href} class:list={[{ active: active === s.key, 'is-new': 'isNew' in s }]}>
        {s.label}
        {'isNew' in s && <span class="tag-new">{strings.nav.new}</span>}
      </a>
    ))}
    <!-- A brand name, so the same in every language (not an i18n string). -->
    <a href="/neuron-uz/" class="nav-neuron">Neuron UZ</a>
  </div>
</nav>

<script>
  // Many browsers ship no Uzbek month names (Intl renders "M09"), so uz is
  // spelled out by hand; en/ru are reliable everywhere.
  const UZ_MONTHS = ['yanvar', 'fevral', 'mart', 'aprel', 'may', 'iyun', 'iyul', 'avgust', 'sentabr', 'oktabr', 'noyabr', 'dekabr'];
  const UZ_DAYS = ['Yakshanba', 'Dushanba', 'Seshanba', 'Chorshanba', 'Payshanba', 'Juma', 'Shanba'];

  const el = document.getElementById('mhToday');
  if (el) {
    const lang = el.dataset.lang || 'uz';
    const long = window.matchMedia('(min-width: 641px)').matches;
    const now = new Date();
    if (lang === 'uz') {
      const date = `${now.getDate()}-${UZ_MONTHS[now.getMonth()]}, ${now.getFullYear()}`;
      el.textContent = long ? `${UZ_DAYS[now.getDay()]}, ${date}` : date;
    } else try {
      el.textContent = new Intl.DateTimeFormat(lang, long
        ? { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }
        : { year: 'numeric', month: 'long', day: 'numeric' }).format(now);
    } catch {
      /* Unsupported locale: leave the slot empty rather than show a wrong language. */
    }
  }
</script>

<style>
  .masthead-block {
    padding-top: 14px;
    text-align: center;
  }
  .dateline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: left;
  }
  .dateline-left { display: flex; gap: 14px; align-items: center; min-width: 0; }
  .today { color: var(--ink); font-weight: 600; white-space: nowrap; }
  .today:empty { display: none; }
  .today:not(:empty) + .dateline-tagline::before { content: '·'; margin-right: 14px; color: var(--ink-soft); }
  .dateline-tagline { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .masthead {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    /* ~12em wide, so 7.4vw always fits the column; balance is the safety net. */
    font-size: clamp(24px, 7.4vw, 44px);
    line-height: 1.05;
    text-wrap: balance;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 14px 0 16px;
  }
  .front .masthead {
    font-size: clamp(24px, 6.4vw, 88px);
    margin: 18px 0 22px;
  }

  .nav-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .lang-switch { display: flex; gap: 10px; }
  .lang-switch a { font-weight: 600; color: var(--ink-soft); }
  .lang-switch a:hover { color: var(--ink); }
  .lang-switch a.active { color: var(--accent); }
  .nav-admin { color: var(--ink-soft); display: flex; }
  .nav-admin:hover { color: var(--ink); }

  .sections {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-top: 1px solid var(--rule);
    border-bottom: 3px double var(--rule);
    transition: background-color .25s ease;
  }
  .sections-inner {
    display: flex;
    justify-content: center;
    gap: 34px;
    padding: 10px 0 9px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sections-inner::-webkit-scrollbar { display: none; }
  .sections a {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-underline-offset: 6px;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color .2s ease;
  }
  .sections a:hover { text-decoration-color: currentColor; }
  .sections a.active { text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
  .sections a.is-new { color: var(--accent); }
  .sections a.nav-neuron {
    background: var(--neuron);
    color: #FFF;
    padding: 3px 12px 2px;
    border: 1px solid #93C5FD;
    border-radius: 2px;
    margin: -3px 0 -2px;
    text-decoration: none;
    text-shadow: 0 0 6px rgba(191, 219, 254, .9);
    /* .sections-inner scrolls on x, which clips on y too: the outer glow has ~6px before it's cut, so it fades out inside that. */
    box-shadow: 0 0 5px var(--neuron), 0 0 12px rgba(96, 165, 250, .8), inset 0 0 8px rgba(191, 219, 254, .5);
    animation: neon-pulse 2.4s ease-in-out infinite;
    transition: filter .2s ease;
  }
  .sections a.nav-neuron:hover { filter: brightness(1.2); animation-play-state: paused; }
  @keyframes neon-pulse {
    50% {
      text-shadow: 0 0 2px rgba(191, 219, 254, .5);
      border-color: #60A5FA;
      box-shadow: 0 0 2px var(--neuron), 0 0 5px rgba(96, 165, 250, .35), inset 0 0 3px rgba(191, 219, 254, .2);
    }
  }

  @media (max-width: 768px) {
    .dateline-tagline { display: none; }
    .today:not(:empty) + .dateline-tagline::before { content: none; }
    .masthead, .front .masthead { margin: 12px 0 14px; }
    /* Sections become a swipeable strip — NYT-app style — instead of wrapping. */
    .sections-inner { justify-content: flex-start; gap: 24px; padding: 10px 14px 9px 2px; } /* right room for the Neuron glow */
  }
  @media (max-width: 380px) {
    .nav-actions { gap: 10px; }
    .lang-switch { gap: 7px; }
  }
</style>
